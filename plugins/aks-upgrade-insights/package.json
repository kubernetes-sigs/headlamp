{
  "name": "aks-upgrade-insights",
  "version": "0.1.0",
  "description": "Fleet and cluster upgrade readiness for AKS Desktop and Headlamp",
  "main": "dist/main.js",
  "scripts": {
    "start": "headlamp-plugin start",
    "build": "headlamp-plugin build",
    "package": "headlamp-plugin package",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test bridge/bridge.test.mjs",
    "demo": "vite --config vite.demo.config.ts --host 127.0.0.1",
    "demo:build": "vite build --config vite.demo.config.ts",
    "bridge": "node bridge/server.mjs"
  },
  "devDependencies": {
    "@kinvolk/headlamp-plugin": "0.14.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "typescript": "5.6.2",
    "vite": "^6.4.1",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  }
}
