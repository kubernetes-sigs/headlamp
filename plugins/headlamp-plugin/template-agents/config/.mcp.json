{
  "mcpServers": {
    "kubernetes": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "kubernetes-mcp-server@0.0.67", "--read-only"]
    },
    "helm": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-server-kubernetes@4.2.3"],
      "env": {
        "ALLOWED_TOOLS": "install_helm_chart,upgrade_helm_chart"
      }
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@1.14.0", "--browser-url=http://127.0.0.1:9222"]
    }
  }
}
