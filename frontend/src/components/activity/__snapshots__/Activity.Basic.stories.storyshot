              </span>
            </button>
            <button
              class="MuiButtonBase MuiIconButton MuiIconButton css-hash"
              tabindex="0"
              title="Minimize"
              type="button"
            >
              <span
                class="MuiTouchRipple css-hash"
              />
            </button>
            <button
              class="MuiButtonBase MuiIconButton MuiIconButton css-hash"
              tabindex="0"
              title="Close"
              type="button"
            >
              <span
                class="MuiTouchRipple css-hash"
              />
            </button>
          </div>
          <div
            class="MuiBox css-hash"
          >
            Right
          </div>
        </div>
      </div>
      <div
        class="MuiBox css-hash"
      >
        <div
          class="MuiBox css-hash"
        >
          <button
