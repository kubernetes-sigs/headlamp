<body>
  <div>
    <div
      class="MuiBox css-hash"
    >
      <div
        class="MuiBox css-hash"
      >
        <h6
          class="MuiTypography MuiTypography css-hash"
        >
          Upgrading Nodes
        </h6>
        <div
          class="MuiPaper MuiPaper MuiPaper css-hash"
        >
          <div
            class="MuiBox css-hash"
          >
            <div
              class="MuiBox css-hash"
            >
              <h6
                class="MuiTypography MuiTypography css-hash"
              >
                aks-node-upgrading
              </h6>
              <div
                class="MuiChip MuiChip MuiChip MuiChip MuiChip css-hash"
              >
                <span
                  class="MuiChip MuiChip css-hash"
                >
                  Ready
                </span>
              </div>
            </div>
            <p
              class="MuiTypography MuiTypography css-hash"
            >
              Version: v1.29.0
            </p>
          </div>
          <div
            class="MuiStepper MuiStepper MuiStepper css-hash"
          >
            <div
              class="Mui-completed MuiStep MuiStep MuiStep css-hash"
            >
              <span
                class="MuiStepLabel MuiStepLabel MuiStepLabel css-hash"
              >
                <span
                  class="Mui-completed MuiStepLabel MuiStepLabel css-hash"
                >
                  <div
                    class="MuiBox css-hash"
                  />
                </span>
                <span
                  class="MuiStepLabel MuiStepLabel css-hash"
                >
                  <span
                    class="Mui-completed MuiStepLabel MuiStepLabel css-hash"
                  >
                    Cordon
                  </span>
                </span>
              </span>
            </div>
            <div
              class="MuiStep MuiStep MuiStep css-hash"
            >
              <div
                class="Mui-active MuiStepConnector MuiStepConnector MuiStepConnector css-hash"
              >
                <span
                  class="MuiStepConnector MuiStepConnector css-hash"
                />
              </div>
              <span
                class="MuiStepLabel MuiStepLabel MuiStepLabel css-hash"
              >
                <span
                  class="Mui-active MuiStepLabel MuiStepLabel css-hash"
                >
                  <div
                    class="MuiBox css-hash"
                  />
                </span>
                <span
                  class="MuiStepLabel MuiStepLabel css-hash"
                >
                  <span
                    class="Mui-active MuiStepLabel MuiStepLabel css-hash"
                  >
                    Drain
                  </span>
                </span>
              </span>
            </div>
            <div
              class="MuiStep MuiStep MuiStep css-hash"
            >
              <div
                class="Mui-disabled MuiStepConnector MuiStepConnector MuiStepConnector css-hash"
              >
                <span
                  class="MuiStepConnector MuiStepConnector css-hash"
                />
              </div>
              <span
                class="Mui-disabled MuiStepLabel MuiStepLabel MuiStepLabel css-hash"
              >
                <span
                  class="Mui-disabled MuiStepLabel MuiStepLabel css-hash"
                >
                  <div
                    class="MuiBox css-hash"
                  />
                </span>
                <span
                  class="MuiStepLabel MuiStepLabel css-hash"
                >
                  <span
                    class="Mui-disabled MuiStepLabel MuiStepLabel css-hash"
                  >
                    Delete
                  </span>
                </span>
              </span>
            </div>
            <div
              class="MuiStep MuiStep MuiStep css-hash"
            >
              <div
                class="Mui-disabled MuiStepConnector MuiStepConnector MuiStepConnector css-hash"
              >
                <span
                  class="MuiStepConnector MuiStepConnector css-hash"
                />
              </div>
              <span
                class="Mui-disabled MuiStepLabel MuiStepLabel MuiStepLabel css-hash"
              >
                <span
                  class="Mui-disabled MuiStepLabel MuiStepLabel css-hash"
                >
                  <div
                    class="MuiBox css-hash"
                  />
                </span>
                <span
                  class="MuiStepLabel MuiStepLabel css-hash"
                >
                  <span
                    class="Mui-disabled MuiStepLabel MuiStepLabel css-hash"
                  >
                    Reimage
                  </span>
                </span>
              </span>
            </div>
            <div
              class="MuiStep MuiStep MuiStep css-hash"
            >
              <div
                class="Mui-disabled MuiStepConnector MuiStepConnector MuiStepConnector css-hash"
              >
                <span
                  class="MuiStepConnector MuiStepConnector css-hash"
                />
              </div>
              <span
                class="Mui-disabled MuiStepLabel MuiStepLabel MuiStepLabel css-hash"
              >
                <span
                  class="Mui-disabled MuiStepLabel MuiStepLabel css-hash"
                >
                  <div
                    class="MuiBox css-hash"
                  />
                </span>
                <span
                  class="MuiStepLabel MuiStepLabel css-hash"
                >
                  <span
                    class="Mui-disabled MuiStepLabel MuiStepLabel css-hash"
                  >
                    Complete
                  </span>
                </span>
              </span>
            </div>
          </div>
        </div>
      </div>
      <div
        class="MuiBox css-hash"
      >
        <h6
          class="MuiTypography MuiTypography css-hash"
        >
          Surge Nodes
        </h6>
        <div
          class="MuiPaper MuiPaper MuiPaper css-hash"
        >
          <div
            class="MuiBox css-hash"
          >
            <h6
              class="MuiTypography MuiTypography css-hash"
            >
              aks-node-surge
            </h6>
            <div
              class="MuiChip MuiChip MuiChip MuiChip MuiChip css-hash"
            >
              <span
                class="MuiChip MuiChip css-hash"
              >
                Ready
              </span>
            </div>
            <div
              class="MuiChip MuiChip MuiChip MuiChip MuiChip css-hash"
            >
              <span
                class="MuiChip MuiChip css-hash"
              >
                Surge Node
              </span>
            </div>
          </div>
          <p
            class="MuiTypography MuiTypography css-hash"
          >
            Version: v1.29.0
          </p>
        </div>
      </div>
      <div
        class="MuiBox css-hash"
      >
        <h6
          class="MuiTypography MuiTypography css-hash"
        >
          Idle Nodes
        </h6>
        <div
          class="MuiPaper MuiPaper MuiPaper css-hash"
        >
          <div
            class="MuiBox css-hash"
          >
            <h6
              class="MuiTypography MuiTypography css-hash"
            >
              aks-node-idle
            </h6>
            <div
              class="MuiChip MuiChip MuiChip MuiChip MuiChip css-hash"
            >
              <span
                class="MuiChip MuiChip css-hash"
              >
                Ready
              </span>
            </div>
          </div>
          <p
            class="MuiTypography MuiTypography css-hash"
          >
            Version: v1.29.0
          </p>
        </div>
      </div>
    </div>
  </div>
</body>