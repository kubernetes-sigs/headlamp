<body>
  <div>
    <div
      class="MuiBox css-hash"
    >
      <p
        class="MuiTypography MuiTypography css-hash"
      >
        Test changing the page and rows per page.
      </p>
      <p
        class="MuiTypography MuiTypography css-hash"
      >
        <b>
          Current URL search:
        </b>
         
        ?p=2
      </p>
      <div
        aria-atomic="true"
        aria-live="polite"
        class="MuiBox css-hash"
        role="status"
      />
      <div
        class="MuiPaper MuiPaper MuiPaper MuiTableContainer css-hash"
        tabindex="0"
      >
        <table
          class="MuiTable css-hash"
        >
          <thead
            class="MuiTableHead css-hash"
          >
            <tr
              class="MuiTableRow MuiTableRow css-hash"
            >
              <th
                class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                scope="col"
              >
                Name
              </th>
              <th
                class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                scope="col"
              >
                Namespace
              </th>
              <th
                class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                scope="col"
              >
                Number
              </th>
            </tr>
          </thead>
          <tbody
            class="MuiTableBody css-hash"
          >
            <tr
              class="MuiTableRow css-hash"
            >
              <td
                class="MuiTableCell MuiTableCell MuiTableCell css-hash"
              >
                Name 5
              </td>
              <td
                class="MuiTableCell MuiTableCell MuiTableCell css-hash"
              >
                Namespace 5
              </td>
              <td
                class="MuiTableCell MuiTableCell MuiTableCell css-hash"
              >
                5
              </td>
            </tr>
            <tr
              class="MuiTableRow css-hash"
            >
              <td
                class="MuiTableCell MuiTableCell MuiTableCell css-hash"
              >
                Name 6
              </td>
              <td
                class="MuiTableCell MuiTableCell MuiTableCell css-hash"
              >
                Namespace 6
              </td>
              <td
                class="MuiTableCell MuiTableCell MuiTableCell css-hash"
              >
                6
              </td>
            </tr>
            <tr
              class="MuiTableRow css-hash"
            >
              <td
                class="MuiTableCell MuiTableCell MuiTableCell css-hash"
              >
                Name 7
              </td>
              <td
                class="MuiTableCell MuiTableCell MuiTableCell css-hash"
              >
                Namespace 7
              </td>
              <td
                class="MuiTableCell MuiTableCell MuiTableCell css-hash"
              >
                7
              </td>
            </tr>
            <tr
              class="MuiTableRow css-hash"
            >
              <td
                class="MuiTableCell MuiTableCell MuiTableCell css-hash"
              >
                Name 8
              </td>
              <td
                class="MuiTableCell MuiTableCell MuiTableCell css-hash"
              >
                Namespace 8
              </td>
              <td
                class="MuiTableCell MuiTableCell MuiTableCell css-hash"
              >
                8
              </td>
            </tr>
            <tr
              class="MuiTableRow css-hash"
            >
              <td
                class="MuiTableCell MuiTableCell MuiTableCell css-hash"
              >
                Name 9
              </td>
              <td
                class="MuiTableCell MuiTableCell MuiTableCell css-hash"
              >
                Namespace 9
              </td>
              <td
                class="MuiTableCell MuiTableCell MuiTableCell css-hash"
              >
                9
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
