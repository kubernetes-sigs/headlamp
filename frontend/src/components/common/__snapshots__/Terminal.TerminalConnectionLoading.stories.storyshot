<body>
  <div
    aria-hidden="true"
  />
  <div
    class="MuiDialog MuiModal css-hash"
    role="presentation"
  >
    <div
      aria-hidden="true"
      class="MuiBackdrop MuiModal css-hash"
      style="opacity: 1; transition: opacity 225ms cubic-bezier(0.4, 0, 0.2, 1) 0ms;"
    />
    <div
      data-testid="sentinelStart"
      tabindex="0"
    />
    <div
      class="MuiDialog MuiDialog css-hash"
      role="presentation"
      style="opacity: 1; transition: opacity 225ms cubic-bezier(0.4, 0, 0.2, 1) 0ms;"
      tabindex="-1"
    >
      <div
        aria-labelledby=":mock-test-id:"
        class="MuiDialog MuiDialog MuiDialog MuiDialog MuiPaper MuiPaper MuiPaper css-hash"
        role="dialog"
      >
        <h2
          class="MuiDialogTitle MuiTypography MuiTypography css-hash"
          id=":mock-test-id:"
          style="display: flex;"
        >
          <div
            class="MuiGrid MuiGrid css-hash"
          >
            <div
              class="MuiGrid MuiGrid css-hash"
            >
              <h1
                class="MuiTypography MuiTypography css-hash"
                id=":mock-test-id:"
                style="font-size: 1.25rem; font-weight: 500; line-height: 1.6;"
              >
                Terminal: mock-pod
              </h1>
            </div>
            <div
              class="MuiGrid MuiGrid css-hash"
            >
              <div
                class="MuiBox css-hash"
              >
                <button
                  aria-label="Toggle fullscreen"
                  class="MuiButtonBase MuiIconButton MuiIconButton css-hash"
                  data-mui-internal-clone-element="true"
                  tabindex="0"
                  type="button"
                >
                  <span
                    class="MuiTouchRipple css-hash"
                  />
                </button>
                <button
                  aria-label="Close"
                  class="MuiButtonBase MuiIconButton MuiIconButton css-hash"
                  data-mui-internal-clone-element="true"
                  tabindex="0"
                  type="button"
                >
                  <span
                    class="MuiTouchRipple css-hash"
                  />
                </button>
              </div>
            </div>
          </div>
        </h2>
        <div
          class="MuiDialogContent css-hash"
        >
          <div
            class="MuiBox css-hash"
          >
            <div
              class="MuiFormControl css-hash"
            >
              <label
                class="MuiFormLabel MuiFormLabel MuiFormLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel css-hash"
                data-shrink="true"
                id="container-name-chooser-label"
              >
                Container
              </label>
              <div
                class="MuiInput MuiInput MuiInputBase MuiInputBase MuiInputBase css-hash"
              >
                <div
                  aria-controls=":mock-test-id:"
                  aria-expanded="false"
                  aria-haspopup="listbox"
                  aria-labelledby="container-name-chooser-label container-name-chooser"
                  class="MuiInput MuiInputBase MuiSelect MuiSelect css-hash"
                  id="container-name-chooser"
                  role="combobox"
                  tabindex="0"
                >
                  main
                </div>
                <input
                  aria-hidden="true"
                  aria-invalid="false"
                  class="MuiSelect css-hash"
                  tabindex="-1"
                  value="main"
                />
                <svg
                  aria-hidden="true"
                  class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium MuiSelect-icon MuiSelect-iconStandard css-pqjvzy-MuiSvgIcon-root-MuiSelect-icon"
                  data-testid="ArrowDropDownIcon"
                  focusable="false"
                  viewBox="0 0 24 24"
                >
                  <path
                    d="M7 10l5 5 5-5z"
                  />
                </svg>
              </div>
            </div>
          </div>
          <div
            class="MuiBox css-hash"
          >
            <div
              id="xterm-container"
              style="flex: 1 1 0%; display: flex; flex-direction: column-reverse;"
            />
          </div>
        </div>
      </div>
    </div>
    <div
      data-testid="sentinelEnd"
      tabindex="0"
    />
  </div>
</body>