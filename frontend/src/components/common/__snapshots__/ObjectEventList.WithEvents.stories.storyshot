<body>
  <div>
    <div
      class="MuiBox css-hash"
    >
      <div
        class="MuiGrid MuiGrid MuiGrid css-hash"
      >
        <div
          class="MuiGrid MuiGrid css-hash"
        >
          <div
            class="MuiBox css-hash"
          >
            <h2
              class="MuiTypography MuiTypography MuiTypography css-hash"
            >
              Events
            </h2>
            <div
              class="MuiBox css-hash"
            >
              <button
                aria-label="Events lifetime information"
                class="MuiButtonBase MuiIconButton MuiIconButton css-hash"
                data-mui-internal-clone-element="true"
                tabindex="0"
                type="button"
              >
                <span
                  class="MuiTouchRipple css-hash"
                />
              </button>
            </div>
          </div>
        </div>
      </div>
      <div
        class="MuiBox css-hash"
      >
        <div
          aria-atomic="true"
          aria-live="polite"
          class="MuiBox css-hash"
          role="status"
        />
        <div
          class="MuiPaper MuiPaper MuiPaper MuiTableContainer css-hash"
          tabindex="0"
        >
          <table
            class="MuiTable css-hash"
          >
            <thead
              class="MuiTableHead css-hash"
            >
              <tr
                class="MuiTableRow MuiTableRow css-hash"
              >
                <th
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                  scope="col"
                >
                  Type
                </th>
                <th
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                  scope="col"
                >
                  Reason
                </th>
                <th
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                  scope="col"
                >
                  From
                </th>
                <th
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                  scope="col"
                >
                  Message
                </th>
                <th
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                  scope="col"
                >
                  Age
                  <button
                    aria-label="Sort ascending"
                    class="MuiButtonBase MuiIconButton MuiIconButton css-hash"
                    data-mui-internal-clone-element="true"
                    tabindex="0"
                    type="button"
                  >
                    <span
                      class="MuiTouchRipple css-hash"
                    />
                  </button>
                </th>
              </tr>
            </thead>
            <tbody
              class="MuiTableBody css-hash"
            >
              <tr
                class="MuiTableRow css-hash"
              >
                <td
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                >
                  Normal
                </td>
                <td
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                >
                  Scheduled
                </td>
                <td
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                >
                  default-scheduler
                </td>
                <td
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                >
                  <div
                    class="MuiBox css-hash"
                  >
                    <span
                      id="event-uid-1"
                      style="word-break: break-all; white-space: normal;"
                    >
                      Successfully assigned default/test-pod-for-events to worker-node-1
                    </span>
                  </div>
                </td>
                <td
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                >
                  <p
                    aria-label="2024-02-14T23:55:00.000Z"
                    class="MuiTypography MuiTypography css-hash"
                    data-mui-internal-clone-element="true"
                  >
                    90d
                  </p>
                </td>
              </tr>
              <tr
                class="MuiTableRow css-hash"
              >
                <td
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                >
                  Normal
                </td>
                <td
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                >
                  Pulled
                </td>
                <td
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                >
                  kubelet
                </td>
                <td
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                >
                  <div
                    class="MuiBox css-hash"
                  >
                    <span
                      id="event-uid-2"
                      style="word-break: break-all; white-space: normal;"
                    >
                      Container image "nginx:latest" already present on machine
                    </span>
                  </div>
                </td>
                <td
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                >
                  <p
                    aria-label="2024-02-14T23:58:00.000Z"
                    class="MuiTypography MuiTypography css-hash"
                    data-mui-internal-clone-element="true"
                  >
                    90d
                  </p>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</body>