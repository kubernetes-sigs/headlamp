<body>
  <div>
    <div
      class="MuiGrid MuiGrid MuiGrid css-hash"
    >
      <div
        class="MuiGrid MuiGrid css-hash"
      >
        <div
          class="MuiBox css-hash"
        >
          <h1
            class="MuiTypography MuiTypography MuiTypography css-hash"
          >
            Pods
          </h1>
          <div
            class="MuiBox css-hash"
          />
        </div>
      </div>
      <div
        class="MuiGrid MuiGrid css-hash"
      >
        <div
          class="MuiGrid MuiGrid MuiGrid css-hash"
        >
          <div
            class="MuiGrid MuiGrid css-hash"
          >
            <div
              class="MuiAutocomplete MuiAutocomplete MuiAutocomplete css-hash"
            >
              <div
                class="MuiBox css-hash"
              >
                <div
                  class="MuiFormControl MuiFormControl MuiTextField css-hash"
                  style="margin-top: 0px;"
                >
                  <label
                    class="MuiFormLabel MuiFormLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel css-hash"
                    data-shrink="true"
                    for="namespaces-filter"
                    id="namespaces-filter-label"
                  >
                    Namespaces
                  </label>
                  <div
                    class="MuiAutocomplete MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                  >
                    <p
                      class="MuiTypography MuiTypography css-hash"
                      style="overflow-wrap: anywhere;"
                    >
                      default
                    </p>
                    <input
                      aria-autocomplete="both"
                      aria-expanded="false"
                      aria-invalid="false"
                      autocapitalize="none"
                      autocomplete="off"
                      class="MuiAutocomplete MuiAutocomplete MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                      id="namespaces-filter"
                      placeholder=""
                      role="combobox"
                      spellcheck="false"
                      type="text"
                      value=""
                    />
                    <div
                      class="MuiAutocomplete css-hash"
                    >
                      <button
                        aria-label="Clear"
                        class="MuiAutocomplete MuiButtonBase MuiIconButton MuiIconButton css-hash"
                        tabindex="-1"
                        title="Clear"
                        type="button"
                      >
                        <svg
                          aria-hidden="true"
                          class="MuiSvgIcon-root MuiSvgIcon-fontSizeSmall css-ptiqhd-MuiSvgIcon-root"
                          data-testid="CloseIcon"
                          focusable="false"
                          viewBox="0 0 24 24"
                        >
                          <path
                            d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                          />
                        </svg>
                        <span
                          class="MuiTouchRipple css-hash"
                        />
                      </button>
                      <button
                        aria-label="Open"
                        class="MuiAutocomplete MuiButtonBase MuiIconButton MuiIconButton css-hash"
                        tabindex="-1"
                        title="Open"
                        type="button"
                      >
                        <svg
                          aria-hidden="true"
                          class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium css-i4bv87-MuiSvgIcon-root"
                          data-testid="ArrowDropDownIcon"
                          focusable="false"
                          viewBox="0 0 24 24"
                        >
                          <path
                            d="M7 10l5 5 5-5z"
                          />
                        </svg>
                        <span
                          class="MuiTouchRipple css-hash"
                        />
                      </button>
                    </div>
                    <fieldset
                      aria-hidden="true"
                      class="MuiOutlinedInput css-hash"
                    >
                      <legend
                        class="css-hash"
                      >
                        <span>
                          Namespaces
                        </span>
                      </legend>
                    </fieldset>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>