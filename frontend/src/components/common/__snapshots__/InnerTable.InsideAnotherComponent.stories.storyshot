<body>
  <div>
    <div
      class="MuiPaper MuiPaper MuiPaper css-hash"
    >
      <h6
        class="MuiTypography MuiTypography MuiTypography css-hash"
      >
        Outer Container Title
      </h6>
      <div
        class="MuiBox css-hash"
      >
        <h6
          class="MuiTypography MuiTypography css-hash"
        >
          Section Containing InnerTable
        </h6>
        <div
          aria-atomic="true"
          aria-live="polite"
          class="MuiBox css-hash"
          role="status"
        />
        <div
          class="MuiPaper MuiPaper MuiPaper MuiTableContainer css-hash"
          tabindex="0"
        >
          <table
            class="MuiTable css-hash"
          >
            <thead
              class="MuiTableHead css-hash"
            >
              <tr
                class="MuiTableRow MuiTableRow css-hash"
              >
                <th
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                  scope="col"
                >
                  Key
                </th>
                <th
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                  scope="col"
                >
                  Value
                </th>
              </tr>
            </thead>
            <tbody
              class="MuiTableBody css-hash"
            >
              <tr
                class="MuiTableRow css-hash"
              >
                <td
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                >
                  config_option_1
                </td>
                <td
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                >
                  true
                </td>
              </tr>
              <tr
                class="MuiTableRow css-hash"
              >
                <td
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                >
                  config_option_2
                </td>
                <td
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                >
                  12345
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</body>