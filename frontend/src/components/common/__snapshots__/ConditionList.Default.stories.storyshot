<body>
  <div>
    <div
      aria-atomic="true"
      aria-live="polite"
      class="MuiBox css-hash"
      role="status"
    />
    <div
      class="MuiPaper MuiPaper MuiPaper MuiTableContainer css-hash"
      tabindex="0"
    >
      <table
        class="MuiTable css-hash"
      >
        <thead
          class="MuiTableHead css-hash"
        >
          <tr
            class="MuiTableRow MuiTableRow css-hash"
          >
            <th
              class="MuiTableCell MuiTableCell MuiTableCell css-hash"
              scope="col"
            >
              Condition
            </th>
            <th
              class="MuiTableCell MuiTableCell MuiTableCell css-hash"
              scope="col"
            >
              Status
            </th>
            <th
              class="MuiTableCell MuiTableCell MuiTableCell css-hash"
              scope="col"
            >
              Last Transition
            </th>
            <th
              class="MuiTableCell MuiTableCell MuiTableCell css-hash"
              scope="col"
            >
              Reason
            </th>
          </tr>
        </thead>
        <tbody
          class="MuiTableBody css-hash"
        >
          <tr
            class="MuiTableRow css-hash"
          >
            <td
              class="MuiTableCell MuiTableCell MuiTableCell css-hash"
            >
              <span
                class="MuiTypography MuiTypography css-hash"
              >
                Ready
              </span>
            </td>
            <td
              class="MuiTableCell MuiTableCell MuiTableCell css-hash"
            >
              True
            </td>
            <td
              class="MuiTableCell MuiTableCell MuiTableCell css-hash"
            >
              -
            </td>
            <td
              class="MuiTableCell MuiTableCell MuiTableCell css-hash"
            >
              <p
                aria-label="Pod is ready"
                class="MuiTypography MuiTypography css-hash"
                data-mui-internal-clone-element="true"
              >
                PodReady
              </p>
            </td>
          </tr>
          <tr
            class="MuiTableRow css-hash"
          >
            <td
              class="MuiTableCell MuiTableCell MuiTableCell css-hash"
            >
              <span
                class="MuiTypography MuiTypography css-hash"
              >
                PodScheduled
              </span>
            </td>
            <td
              class="MuiTableCell MuiTableCell MuiTableCell css-hash"
            >
              False
            </td>
            <td
              class="MuiTableCell MuiTableCell MuiTableCell css-hash"
            >
              -
            </td>
            <td
              class="MuiTableCell MuiTableCell MuiTableCell css-hash"
            >
              <p
                aria-label="No nodes available"
                class="MuiTypography MuiTypography css-hash"
                data-mui-internal-clone-element="true"
              >
                Unschedulable
              </p>
            </td>
          </tr>
          <tr
            class="MuiTableRow css-hash"
          >
            <td
              class="MuiTableCell MuiTableCell MuiTableCell css-hash"
            >
              <span
                class="MuiTypography MuiTypography css-hash"
              >
                Initialized
              </span>
            </td>
            <td
              class="MuiTableCell MuiTableCell MuiTableCell css-hash"
            >
              Unknown
            </td>
            <td
              class="MuiTableCell MuiTableCell MuiTableCell css-hash"
            >
              -
            </td>
            <td
              class="MuiTableCell MuiTableCell MuiTableCell css-hash"
            >
              -
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</body>