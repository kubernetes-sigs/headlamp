<body>
  <div>
    <div
      class="MuiBox css-hash"
    >
      <div
        aria-label="Resource form"
        class="MuiBox css-hash"
      >
        <fieldset
          class="MuiBox css-hash"
        >
          <legend
            class="MuiTypography MuiTypography css-hash"
          >
            Containers
          </legend>
          <div
            class="MuiBox css-hash"
          >
            <div
              class="MuiBox css-hash"
            >
              <div
                class="MuiBox css-hash"
              >
                <div
                  class="MuiBox css-hash"
                >
                  <span
                    class="MuiTypography MuiTypography css-hash"
                  >
                    Containers
                  </span>
                </div>
                <div
                  aria-labelledby="container-group-id"
                  class="MuiBox css-hash"
                  role="group"
                >
                  <div
                    class="MuiBox css-hash"
                  >
                    <div
                      class="MuiBox css-hash"
                    >
                      <div
                        class="MuiFormControl MuiFormControl MuiTextField css-hash"
                      >
                        <label
                          class="MuiFormLabel MuiFormLabel MuiFormLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel css-hash"
                          data-shrink="true"
                          for=":mock-test-id:"
                          id=":mock-test-id:"
                        >
                          Name *
                        </label>
                        <div
                          class="MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                        >
                          <input
                            aria-invalid="false"
                            aria-label="Container name"
                            class="MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                            id=":mock-test-id:"
                            type="text"
                            value="nginx"
                          />
                          <fieldset
                            aria-hidden="true"
                            class="MuiOutlinedInput css-hash"
                          >
                            <legend
                              class="css-hash"
                            >
                              <span>
                                Name *
                              </span>
                            </legend>
                          </fieldset>
                        </div>
                      </div>
                      <div
                        class="MuiFormControl MuiFormControl MuiTextField css-hash"
                      >
                        <label
                          class="MuiFormLabel MuiFormLabel MuiFormLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel css-hash"
                          data-shrink="true"
                          for=":mock-test-id:"
                          id=":mock-test-id:"
                        >
                          Image *
                        </label>
                        <div
                          class="MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                        >
                          <input
                            aria-invalid="false"
                            aria-label="Container image"
                            class="MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                            id=":mock-test-id:"
                            type="text"
                            value="nginx:latest"
                          />
                          <fieldset
                            aria-hidden="true"
                            class="MuiOutlinedInput css-hash"
                          >
                            <legend
                              class="css-hash"
                            >
                              <span>
                                Image *
                              </span>
                            </legend>
                          </fieldset>
                        </div>
                      </div>
                      <div
                        class="MuiFormControl MuiFormControl MuiTextField css-hash"
                      >
                        <label
                          class="MuiFormLabel MuiFormLabel MuiFormLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel css-hash"
                          data-shrink="true"
                          for=":mock-test-id:"
                          id=":mock-test-id:"
                        >
                          Container Port
                        </label>
                        <div
                          class="MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                        >
                          <input
                            aria-invalid="false"
                            aria-label="Container port"
                            class="MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                            id=":mock-test-id:"
                            type="number"
                            value="80"
                          />
                          <fieldset
                            aria-hidden="true"
                            class="MuiOutlinedInput css-hash"
                          >
                            <legend
                              class="css-hash"
                            >
                              <span>
                                Container Port
                              </span>
                            </legend>
                          </fieldset>
                        </div>
                      </div>
                      <button
                        aria-label="Remove container nginx"
                        class="MuiButtonBase MuiIconButton MuiIconButton css-hash"
                        tabindex="0"
                        type="button"
                      >
                        <span
                          class="MuiTouchRipple css-hash"
                        />
                      </button>
                    </div>
                    <div
                      class="MuiBox css-hash"
                    >
                      <div
                        class="MuiFormControl MuiFormControl MuiTextField css-hash"
                      >
                        <label
                          class="MuiFormLabel MuiFormLabel MuiFormLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel css-hash"
                          data-shrink="true"
                          for=":mock-test-id:"
                          id=":mock-test-id:"
                        >
                          Pull Policy
                        </label>
                        <div
                          class="MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                        >
                          <div
                            aria-controls=":mock-test-id:"
                            aria-expanded="false"
                            aria-haspopup="listbox"
                            aria-label="Image pull policy"
                            aria-labelledby=":mock-test-id:"
                            class="MuiInputBase MuiInputBase MuiOutlinedInput MuiSelect MuiSelect css-hash"
                            id=":mock-test-id:"
                            role="combobox"
                            tabindex="0"
                          >
                            Always
                          </div>
                          <input
                            aria-hidden="true"
                            aria-invalid="false"
                            class="MuiSelect css-hash"
                            tabindex="-1"
                            value="Always"
                          />
                          <svg
                            aria-hidden="true"
                            class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium MuiSelect-icon MuiSelect-iconOutlined css-hfutr2-MuiSvgIcon-root-MuiSelect-icon"
                            data-testid="ArrowDropDownIcon"
                            focusable="false"
                            viewBox="0 0 24 24"
                          >
                            <path
                              d="M7 10l5 5 5-5z"
                            />
                          </svg>
                          <fieldset
                            aria-hidden="true"
                            class="MuiOutlinedInput css-hash"
                          >
                            <legend
                              class="css-hash"
                            >
                              <span>
                                Pull Policy
                              </span>
                            </legend>
                          </fieldset>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div
                    class="MuiBox css-hash"
                  >
                    <button
                      aria-label="Add container"
                      class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
                      tabindex="0"
                      type="button"
                    >
                      <p
                        class="MuiTypography MuiTypography css-hash"
                      >
                        New Container
                      </p>
                      <span
                        class="MuiTouchRipple css-hash"
                      />
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </fieldset>
      </div>
    </div>
  </div>
</body>