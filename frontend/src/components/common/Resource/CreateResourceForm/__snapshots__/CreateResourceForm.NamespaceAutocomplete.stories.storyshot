<body>
  <div>
    <div
      class="MuiBox css-hash"
    >
      <div
        aria-label="Resource form"
        class="MuiBox css-hash"
      >
        <fieldset
          class="MuiBox css-hash"
        >
          <legend
            class="MuiTypography MuiTypography css-hash"
          >
            Metadata
          </legend>
          <div
            class="MuiBox css-hash"
          >
            <div
              class="MuiBox css-hash"
            >
              <div
                class="MuiBox css-hash"
              >
                <div
                  class="MuiBox css-hash"
                >
                  <span
                    class="MuiTypography MuiTypography css-hash"
                  >
                    Namespace
                  </span>
                </div>
                <div
                  class="MuiAutocomplete MuiAutocomplete css-hash"
                >
                  <div
                    class="MuiFormControl MuiFormControl MuiTextField css-hash"
                  >
                    <div
                      class="MuiAutocomplete MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                    >
                      <input
                        aria-autocomplete="list"
                        aria-expanded="false"
                        aria-invalid="false"
                        autocapitalize="none"
                        autocomplete="off"
                        class="MuiAutocomplete MuiAutocomplete MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                        id=":mock-test-id:"
                        role="combobox"
                        spellcheck="false"
                        type="text"
                        value="default"
                      />
                      <div
                        class="MuiAutocomplete css-hash"
                      >
                        <button
                          aria-label="Clear"
                          class="MuiAutocomplete MuiButtonBase MuiIconButton MuiIconButton css-hash"
                          tabindex="-1"
                          title="Clear"
                          type="button"
                        >
                          <svg
                            aria-hidden="true"
                            class="MuiSvgIcon-root MuiSvgIcon-fontSizeSmall css-ptiqhd-MuiSvgIcon-root"
                            data-testid="CloseIcon"
                            focusable="false"
                            viewBox="0 0 24 24"
                          >
                            <path
                              d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                            />
                          </svg>
                          <span
                            class="MuiTouchRipple css-hash"
                          />
                        </button>
                      </div>
                      <fieldset
                        aria-hidden="true"
                        class="MuiOutlinedInput css-hash"
                      >
                        <legend
                          class="css-hash"
                        >
                          <span
                            class="notranslate"
                          >
                            ​
                          </span>
                        </legend>
                      </fieldset>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </fieldset>
      </div>
    </div>
  </div>
</body>