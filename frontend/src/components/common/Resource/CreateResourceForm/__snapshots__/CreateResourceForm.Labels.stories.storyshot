<body>
  <div>
    <div
      class="MuiBox css-hash"
    >
      <div
        aria-label="Resource form"
        class="MuiBox css-hash"
      >
        <fieldset
          class="MuiBox css-hash"
        >
          <legend
            class="MuiTypography MuiTypography css-hash"
          >
            Metadata
          </legend>
          <div
            class="MuiBox css-hash"
          >
            <div
              class="MuiBox css-hash"
            >
              <div
                class="MuiBox css-hash"
              >
                <div
                  class="MuiBox css-hash"
                >
                  <span
                    class="MuiTypography MuiTypography css-hash"
                  >
                    Labels
                  </span>
                </div>
                <div
                  aria-labelledby="label-group-id"
                  class="MuiBox css-hash"
                  role="group"
                >
                  <div
                    class="MuiBox css-hash"
                  >
                    <div
                      class="MuiFormControl MuiFormControl MuiTextField css-hash"
                    >
                      <label
                        class="MuiFormLabel MuiFormLabel MuiFormLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel css-hash"
                        data-shrink="true"
                        for=":mock-test-id:"
                        id=":mock-test-id:"
                      >
                        Key
                      </label>
                      <div
                        class="MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                      >
                        <input
                          aria-invalid="false"
                          aria-label="Label key"
                          class="MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                          id=":mock-test-id:"
                          type="text"
                          value="app"
                        />
                        <fieldset
                          aria-hidden="true"
                          class="MuiOutlinedInput css-hash"
                        >
                          <legend
                            class="css-hash"
                          >
                            <span>
                              Key
                            </span>
                          </legend>
                        </fieldset>
                      </div>
                    </div>
                    <div
                      class="MuiFormControl MuiFormControl MuiTextField css-hash"
                    >
                      <label
                        class="MuiFormLabel MuiFormLabel MuiFormLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel css-hash"
                        data-shrink="true"
                        for=":mock-test-id:"
                        id=":mock-test-id:"
                      >
                        Value
                      </label>
                      <div
                        class="MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                      >
                        <input
                          aria-invalid="false"
                          aria-label="Label value"
                          class="MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                          id=":mock-test-id:"
                          type="text"
                          value="frontend"
                        />
                        <fieldset
                          aria-hidden="true"
                          class="MuiOutlinedInput css-hash"
                        >
                          <legend
                            class="css-hash"
                          >
                            <span>
                              Value
                            </span>
                          </legend>
                        </fieldset>
                      </div>
                    </div>
                    <button
                      aria-label="Remove label app=frontend"
                      class="MuiButtonBase MuiIconButton MuiIconButton css-hash"
                      tabindex="0"
                      type="button"
                    >
                      <span
                        class="MuiTouchRipple css-hash"
                      />
                    </button>
                  </div>
                  <div
                    class="MuiBox css-hash"
                  >
                    <div
                      class="MuiFormControl MuiFormControl MuiTextField css-hash"
                    >
                      <label
                        class="MuiFormLabel MuiFormLabel MuiFormLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel css-hash"
                        data-shrink="true"
                        for=":mock-test-id:"
                        id=":mock-test-id:"
                      >
                        Key
                      </label>
                      <div
                        class="MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                      >
                        <input
                          aria-invalid="false"
                          aria-label="Label key"
                          class="MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                          id=":mock-test-id:"
                          type="text"
                          value="env"
                        />
                        <fieldset
                          aria-hidden="true"
                          class="MuiOutlinedInput css-hash"
                        >
                          <legend
                            class="css-hash"
                          >
                            <span>
                              Key
                            </span>
                          </legend>
                        </fieldset>
                      </div>
                    </div>
                    <div
                      class="MuiFormControl MuiFormControl MuiTextField css-hash"
                    >
                      <label
                        class="MuiFormLabel MuiFormLabel MuiFormLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel css-hash"
                        data-shrink="true"
                        for=":mock-test-id:"
                        id=":mock-test-id:"
                      >
                        Value
                      </label>
                      <div
                        class="MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                      >
                        <input
                          aria-invalid="false"
                          aria-label="Label value"
                          class="MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                          id=":mock-test-id:"
                          type="text"
                          value="production"
                        />
                        <fieldset
                          aria-hidden="true"
                          class="MuiOutlinedInput css-hash"
                        >
                          <legend
                            class="css-hash"
                          >
                            <span>
                              Value
                            </span>
                          </legend>
                        </fieldset>
                      </div>
                    </div>
                    <button
                      aria-label="Remove label env=production"
                      class="MuiButtonBase MuiIconButton MuiIconButton css-hash"
                      tabindex="0"
                      type="button"
                    >
                      <span
                        class="MuiTouchRipple css-hash"
                      />
                    </button>
                  </div>
                  <div
                    class="MuiBox css-hash"
                  >
                    <button
                      aria-label="Add label"
                      class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
                      tabindex="0"
                      type="button"
                    >
                      <p
                        class="MuiTypography MuiTypography css-hash"
                      >
                        New Label
                      </p>
                      <span
                        class="MuiTouchRipple css-hash"
                      />
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </fieldset>
      </div>
    </div>
  </div>
</body>