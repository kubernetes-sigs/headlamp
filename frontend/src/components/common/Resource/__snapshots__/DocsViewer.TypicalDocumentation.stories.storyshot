<body>
  <div>
    <div
      class="MuiBox css-hash"
    >
      <p
        class="MuiTypography MuiTypography css-hash"
      >
        Showing documentation for: Pod
      </p>
      <ul
        aria-multiselectable="false"
        class="MuiTreeView css-hash"
        id=":mock-test-id:"
        role="tree"
        tabindex="0"
      >
        <li
          aria-expanded="false"
          class="MuiTreeItem css-hash"
          id=":mock-test-id:"
          role="treeitem"
          tabindex="-1"
        >
          <div
            class="MuiTreeItem css-hash"
          >
            <div
              class="MuiTreeItem"
            />
            <div
              class="MuiTreeItem"
            >
              <div>
                <p
                  class="MuiTypography MuiTypography css-hash"
                >
                  apiVersion
                </p>
                 
                <span
                  class="MuiTypography MuiTypography css-hash"
                >
                  (
                  string
                  )
                </span>
              </div>
            </div>
          </div>
        </li>
        <li
          aria-expanded="false"
          class="MuiTreeItem css-hash"
          id=":mock-test-id:"
          role="treeitem"
          tabindex="-1"
        >
          <div
            class="MuiTreeItem css-hash"
          >
            <div
              class="MuiTreeItem"
            />
            <div
              class="MuiTreeItem"
            >
              <div>
                <p
                  class="MuiTypography MuiTypography css-hash"
                >
                  kind
                </p>
                 
                <span
                  class="MuiTypography MuiTypography css-hash"
                >
                  (
                  string
                  )
                </span>
              </div>
            </div>
          </div>
        </li>
        <li
          aria-expanded="false"
          class="MuiTreeItem css-hash"
          id=":mock-test-id:"
          role="treeitem"
          tabindex="-1"
        >
          <div
            class="MuiTreeItem css-hash"
          >
            <div
              class="MuiTreeItem"
            />
            <div
              class="MuiTreeItem"
            >
              <div>
                <p
                  class="MuiTypography MuiTypography css-hash"
                >
                  metadata
                </p>
                 
                <span
                  class="MuiTypography MuiTypography css-hash"
                >
                  (
                  object
                  )
                </span>
              </div>
            </div>
          </div>
        </li>
        <li
          aria-expanded="false"
          class="MuiTreeItem css-hash"
          id=":mock-test-id:"
          role="treeitem"
          tabindex="-1"
        >
          <div
            class="MuiTreeItem css-hash"
          >
            <div
              class="MuiTreeItem"
            />
            <div
              class="MuiTreeItem"
            >
              <div>
                <p
                  class="MuiTypography MuiTypography css-hash"
                >
                  spec
                </p>
                 
                <span
                  class="MuiTypography MuiTypography css-hash"
                >
                  (
                  object
                  )
                </span>
              </div>
            </div>
          </div>
        </li>
      </ul>
    </div>
  </div>
</body>