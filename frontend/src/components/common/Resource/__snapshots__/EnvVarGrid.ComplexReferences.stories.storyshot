<body>
  <div>
    <div
      class="MuiBox css-hash"
    >
      <div
        class="MuiBox css-hash"
      >
        <span
          class="MuiTypography MuiTypography css-hash"
        >
          API_KEY
          :
           
          <a
            class="MuiLink MuiLink MuiTypography MuiTypography css-hash"
            href="/c/minikube/secrets/default/my-secret"
            style="text-decoration: underline; font-weight: bold;"
          >
            Secret: 
            my-secret
             
            (Key: api-key)
          </a>
        </span>
        <span
          class="MuiTypography MuiTypography css-hash"
        >
          APP_CONFIG
          :
           
          <a
            class="MuiLink MuiLink MuiTypography MuiTypography css-hash"
            href="/c/minikube/configmaps/default/app-config"
            style="text-decoration: underline; font-weight: bold;"
          >
            ConfigMap: 
            app-config
             
            (Key: config.json)
          </a>
        </span>
        <span
          class="MuiTypography MuiTypography css-hash"
        >
          MY_POD_IP
          : FieldRef 
          (status.podIP)
        </span>
        <span
          class="MuiTypography MuiTypography css-hash"
        >
          CPU_LIMIT
          : ResourceField
           
          (limits.cpu)
        </span>
      </div>
    </div>
  </div>
</body>