<body>
  <div>
    <div
      class="MuiSnackbar MuiSnackbar css-hash"
      role="presentation"
    >
      <div
        aria-describedby="updatePopup"
        class="MuiPaper MuiPaper MuiSnackbarContent css-hash"
        direction="up"
        role="alert"
        style="opacity: 1; transform: none; transition: opacity 225ms cubic-bezier(0.4, 0, 0.2, 1) 0ms,transform 150ms cubic-bezier(0.4, 0, 0.2, 1) 0ms;"
      >
        <div
          class="MuiSnackbarContent css-hash"
        >
          Fetching release information…
        </div>
        <div
          class="MuiSnackbarContent css-hash"
        >
          <button
            class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
            style="color: rgb(255, 242, 0);"
            tabindex="0"
            type="button"
          >
            Skip
            <span
              class="MuiTouchRipple css-hash"
            />
          </button>
        </div>
      </div>
    </div>
  </div>
</body>