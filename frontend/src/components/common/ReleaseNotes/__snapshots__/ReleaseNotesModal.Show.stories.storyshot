<body>
  <div
    aria-hidden="true"
  />
  <div
    class="MuiDialog MuiModal css-hash"
    role="presentation"
  >
    <div
      aria-hidden="true"
      class="MuiBackdrop MuiModal css-hash"
      style="opacity: 1; transition: opacity 225ms cubic-bezier(0.4, 0, 0.2, 1) 0ms;"
    />
    <div
      data-testid="sentinelStart"
      tabindex="0"
    />
    <div
      class="MuiDialog MuiDialog css-hash"
      role="presentation"
      style="opacity: 1; transition: opacity 225ms cubic-bezier(0.4, 0, 0.2, 1) 0ms;"
      tabindex="-1"
    >
      <div
        aria-labelledby=":mock-test-id:"
        class="MuiDialog MuiDialog MuiDialog MuiPaper MuiPaper MuiPaper css-hash"
        role="dialog"
      >
        <h2
          class="MuiDialogTitle MuiTypography MuiTypography css-hash"
          id=":mock-test-id:"
          style="display: flex;"
        >
          <div
            class="MuiGrid MuiGrid css-hash"
          >
            <div
              class="MuiGrid MuiGrid css-hash"
            >
              <h1
                class="MuiTypography MuiTypography css-hash"
                style="font-size: 1.25rem; font-weight: 500; line-height: 1.6;"
              >
                Release Notes (1.9.9)
              </h1>
            </div>
            <div
              class="MuiGrid MuiGrid css-hash"
            >
              <div
                class="MuiBox css-hash"
              >
                <button
                  aria-label="Close"
                  class="MuiButtonBase MuiIconButton MuiIconButton css-hash"
                  tabindex="0"
                  type="button"
                >
                  <span
                    class="MuiTouchRipple css-hash"
                  />
                </button>
              </div>
            </div>
          </div>
        </h2>
        <div
          class="MuiDialogContent MuiDialogContent css-hash"
        >
          <div
            class="MuiBox css-hash"
          >
            <h1>
              Release Notes
            </h1>
            

            <h2>
              Hello
            </h2>
            

            <h3>
              Sub-heading
            </h3>
            

            <p>
              world
            </p>
            

            <h2>
              Changes
            </h2>
            

            <table>
              <thead>
                <tr>
                  <th>
                    Feature
                  </th>
                  <th>
                    Status
                  </th>
                  <th>
                    Notes
                  </th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>
                    Dark mode
                  </td>
                  <td>
                    ✅ Done
                  </td>
                  <td>
                    Available in settings
                  </td>
                </tr>
                <tr>
                  <td>
                    Tables
                  </td>
                  <td>
                    ✅ Done
                  </td>
                  <td>
                    Now rendered properly
                  </td>
                </tr>
                <tr>
                  <td>
                    Images
                  </td>
                  <td>
                    ✅ Done
                  </td>
                  <td>
                    Bounded to container
                  </td>
                </tr>
              </tbody>
            </table>
            

            <h2>
              Screenshot
            </h2>
            

            <p>
              <img
                alt="Example release screenshot"
                src="https://github.com/user-attachments/assets/674137f5-99db-4d7f-ab50-d91b19202704"
              />
            </p>
            

            <h2>
              Code Example
            </h2>
            

            <pre>
              <code
                class="language-yaml"
              >
                apiVersion: v1
kind: Pod

              </code>
            </pre>
            

            <blockquote>
              

              <p>
                <strong>
                  Note:
                </strong>
                 This is a blockquote with important information.
              </p>
              

            </blockquote>
          </div>
        </div>
      </div>
    </div>
    <div
      data-testid="sentinelEnd"
      tabindex="0"
    />
  </div>
</body>