<body>
  <div
    aria-hidden="true"
  >
    <div
      class="MuiSnackbar MuiSnackbar css-hash"
      role="presentation"
    >
      <div
        aria-describedby="updatePopup"
        class="MuiPaper MuiPaper MuiSnackbarContent css-hash"
        direction="up"
        role="alert"
        style="opacity: 1; transform: none; transition: opacity 225ms cubic-bezier(0.4, 0, 0.2, 1) 0ms,transform 150ms cubic-bezier(0.4, 0, 0.2, 1) 0ms;"
      >
        <div
          class="MuiSnackbarContent css-hash"
        >
          An update is available
        </div>
        <div
          class="MuiSnackbarContent css-hash"
        >
          <div
            class="MuiBox css-hash"
          >
            <div
              class="MuiBox css-hash"
            >
              <button
                class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
                style="color: inherit; text-transform: none;"
                tabindex="0"
                type="button"
              >
                Read more
                <span
                  class="MuiTouchRipple css-hash"
                />
              </button>
            </div>
            <div
              class="MuiBox css-hash"
            >
              <button
                aria-label="Disable update notifications"
                class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
                style="color: rgb(255, 242, 0);"
                tabindex="0"
                type="button"
              >
                <span
                  class="MuiTouchRipple css-hash"
                />
              </button>
            </div>
            <div
              class="MuiBox css-hash"
            >
              <button
                class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
                style="color: rgb(255, 242, 0);"
                tabindex="0"
                type="button"
              >
                Dismiss
                <span
                  class="MuiTouchRipple css-hash"
                />
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div
    class="MuiDialog MuiModal css-hash"
    role="presentation"
  >
    <div
      aria-hidden="true"
      class="MuiBackdrop MuiModal css-hash"
      style="opacity: 1; transition: opacity 225ms cubic-bezier(0.4, 0, 0.2, 1) 0ms;"
    />
    <div
      data-testid="sentinelStart"
      tabindex="0"
    />
    <div
      class="MuiDialog MuiDialog css-hash"
      role="presentation"
      style="opacity: 1; transition: opacity 225ms cubic-bezier(0.4, 0, 0.2, 1) 0ms;"
      tabindex="-1"
    >
      <div
        aria-labelledby=":mock-test-id:"
        class="MuiDialog MuiDialog MuiDialog MuiPaper MuiPaper MuiPaper css-hash"
        role="dialog"
      >
        <h2
          class="MuiDialogTitle MuiTypography MuiTypography css-hash"
          id=":mock-test-id:"
          style="display: flex;"
        >
          <div
            class="MuiGrid MuiGrid css-hash"
          >
            <div
              class="MuiGrid MuiGrid css-hash"
            >
              <h1
                class="MuiTypography MuiTypography css-hash"
                style="font-size: 1.25rem; font-weight: 500; line-height: 1.6;"
              >
                Release Notes (1.9.9)
              </h1>
            </div>
            <div
              class="MuiGrid MuiGrid css-hash"
            >
              <div
                class="MuiBox css-hash"
              >
                <button
                  aria-label="Close"
                  class="MuiButtonBase MuiIconButton MuiIconButton css-hash"
                  tabindex="0"
                  type="button"
                >
                  <span
                    class="MuiTouchRipple css-hash"
                  />
                </button>
              </div>
            </div>
          </div>
        </h2>
        <div
          class="MuiDialogContent MuiDialogContent css-hash"
        >
          <div
            class="MuiBox css-hash"
          >
            <h2>
              Hello
            </h2>
            

            <h3>
              Sub-heading
            </h3>
            

            <p>
              world
            </p>
          </div>
        </div>
      </div>
    </div>
    <div
      data-testid="sentinelEnd"
      tabindex="0"
    />
  </div>
</body>