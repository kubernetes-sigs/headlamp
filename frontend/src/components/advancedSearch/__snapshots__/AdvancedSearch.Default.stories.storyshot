<body>
  <div>
    <div
      class="MuiBox css-hash"
    >
      <div
        class="MuiGrid MuiGrid MuiGrid css-hash"
      >
        <div
          class="MuiGrid MuiGrid css-hash"
        >
          <div
            class="MuiBox css-hash"
          >
            <h1
              class="MuiTypography MuiTypography MuiTypography css-hash"
            >
              Advanced Search (Beta)
            </h1>
            <div
              class="MuiBox css-hash"
            />
          </div>
        </div>
      </div>
      <div
        class="MuiBox css-hash"
      >
        <span
          class="MuiBadge css-hash"
        >
          <button
            class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
            tabindex="0"
            type="button"
          >
            <span
              class="MuiButton MuiButton MuiButton css-hash"
            />
            Select Resources
            <span
              class="MuiTouchRipple css-hash"
            />
          </button>
          <span
            class="MuiBadge MuiBadge MuiBadge MuiBadge MuiBadge MuiBadge MuiBadge css-hash"
            style="top: 4px; right: 4px;"
          />
        </span>
        <span
          class="MuiBadge css-hash"
        >
          <button
            class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
            tabindex="0"
            type="button"
          >
            <span
              class="MuiButton MuiButton MuiButton css-hash"
            />
            Saved Searches
            <span
              class="MuiTouchRipple css-hash"
            />
          </button>
          <span
            class="MuiBadge MuiBadge MuiBadge MuiBadge MuiBadge MuiBadge MuiBadge css-hash"
            style="top: 4px; right: 4px;"
          />
        </span>
        <button
          class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
          tabindex="0"
          type="button"
        >
          <span
            class="MuiButton MuiButton MuiButton css-hash"
          />
          Settings
          <span
            class="MuiTouchRipple css-hash"
          />
        </button>
        <div
          class="MuiBox css-hash"
        >
          <div
            class="MuiAutocomplete MuiAutocomplete css-hash"
          >
            <div
              class="MuiBox css-hash"
            >
              <div
                class="MuiFormControl MuiFormControl MuiTextField css-hash"
                style="margin-top: 0px;"
              >
                <label
                  class="MuiFormLabel MuiFormLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel css-hash"
                  data-shrink="true"
                  for="namespaces-filter"
                  id="namespaces-filter-label"
                >
                  Namespaces
                </label>
                <div
                  class="MuiAutocomplete MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                >
                  <input
                    aria-autocomplete="both"
                    aria-expanded="false"
                    aria-invalid="false"
                    autocapitalize="none"
                    autocomplete="off"
                    class="MuiAutocomplete MuiAutocomplete MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                    id="namespaces-filter"
                    placeholder="Filter"
                    role="combobox"
                    spellcheck="false"
                    type="text"
                    value=""
                  />
                  <div
                    class="MuiAutocomplete css-hash"
                  >
                    <button
                      aria-label="Open"
                      class="MuiAutocomplete MuiButtonBase MuiIconButton MuiIconButton css-hash"
                      tabindex="-1"
                      title="Open"
                      type="button"
                    >
                      <svg
                        aria-hidden="true"
                        class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium css-i4bv87-MuiSvgIcon-root"
                        data-testid="ArrowDropDownIcon"
                        focusable="false"
                        viewBox="0 0 24 24"
                      >
                        <path
                          d="M7 10l5 5 5-5z"
                        />
                      </svg>
                      <span
                        class="MuiTouchRipple css-hash"
                      />
                    </button>
                  </div>
                  <fieldset
                    aria-hidden="true"
                    class="MuiOutlinedInput css-hash"
                  >
                    <legend
                      class="css-hash"
                    >
                      <span>
                        Namespaces
                      </span>
                    </legend>
                  </fieldset>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div
        class="MuiBox css-hash"
      >
        <div
          class="MuiBox css-hash"
        >
          Search resources by query
        </div>
        <div
          class="MuiBox css-hash"
        >
          <div
            class="mock-monaco-editor"
          />
        </div>
        <button
          aria-label="Clear"
          class="MuiButtonBase MuiIconButton MuiIconButton css-hash"
          data-mui-internal-clone-element="true"
          tabindex="0"
          type="button"
        >
          <span
            class="MuiTouchRipple css-hash"
          />
        </button>
      </div>
      <div
        class="MuiBox css-hash"
      >
        <div
          class="MuiBox css-hash"
        >
          No resources selected
        </div>
      </div>
      <div
        class="MuiBox css-hash"
      />
      <div
        class="MuiBox css-hash"
      >
        <p
          class="MuiTypography MuiTypography css-hash"
        >
          Examples
        </p>
        <div
          class="MuiBox css-hash"
        >
          <button
            class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
            tabindex="0"
            type="button"
          >
            All Resources
            <div
              class="MuiBox css-hash"
            >
              <pre
                class="css-hash"
              >
                metadata.labels["kubernetes.io/cluster-service"] === "true"
              </pre>
            </div>
            <span
              class="MuiTouchRipple css-hash"
            />
          </button>
          <button
            class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
            tabindex="0"
            type="button"
          >
            All Resources
            <div
              class="MuiBox css-hash"
            >
              <pre
                class="css-hash"
              >
                metadata.annotations["deployment.kubernetes.io/revision"] &gt; 10
              </pre>
            </div>
            <span
              class="MuiTouchRipple css-hash"
            />
          </button>
        </div>
      </div>
    </div>
  </div>
</body>