<body>
  <div>
    <button
      class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
      tabindex="0"
      type="button"
    >
      <span
        class="MuiButton MuiButton MuiButton css-hash"
      />
      <p
        class="MuiTypography MuiTypography css-hash"
        style="padding-top: 3px;"
      >
        Back
      </p>
      <span
        class="MuiTouchRipple css-hash"
      />
    </button>
    <div
      class="MuiBox css-hash"
    >
      <div
        class="MuiGrid MuiGrid MuiGrid css-hash"
      >
        <div
          class="MuiGrid MuiGrid css-hash"
        >
          <div
            class="MuiBox css-hash"
          >
            <h2
              class="MuiTypography MuiTypography MuiTypography css-hash"
            >
              Cluster Settings
            </h2>
            <div
              class="MuiBox css-hash"
            />
          </div>
        </div>
      </div>
      <div
        class="MuiBox css-hash"
      >
        <div
          class="MuiBox css-hash"
        >
          <div
            class="MuiFormControl MuiFormControl css-hash"
          >
            <label
              class="MuiFormLabel MuiFormLabel MuiFormLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel css-hash"
              data-shrink="true"
              id="settings--cluster-selector"
            >
              Cluster
            </label>
            <div
              aria-label="Cluster selector"
              class="MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
            >
              <div
                aria-controls=":mock-test-id:"
                aria-expanded="false"
                aria-haspopup="listbox"
                aria-labelledby="settings--cluster-selector"
                class="MuiInputBase MuiInputBase MuiOutlinedInput MuiSelect MuiSelect css-hash"
                role="combobox"
                tabindex="0"
              >
                my-cluster
              </div>
              <input
                aria-hidden="true"
                aria-invalid="false"
                class="MuiSelect css-hash"
                tabindex="-1"
                value="my-cluster"
              />
              <svg
                aria-hidden="true"
                class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium MuiSelect-icon MuiSelect-iconOutlined css-hfutr2-MuiSvgIcon-root-MuiSelect-icon"
                data-testid="ArrowDropDownIcon"
                focusable="false"
                viewBox="0 0 24 24"
              >
                <path
                  d="M7 10l5 5 5-5z"
                />
              </svg>
              <fieldset
                aria-hidden="true"
                class="MuiOutlinedInput css-hash"
              >
                <legend
                  class="css-hash"
                >
                  <span>
                    Cluster
                  </span>
                </legend>
              </fieldset>
            </div>
          </div>
          <a
            aria-label="Go to cluster"
            class="MuiLink MuiLink MuiTypography MuiTypography css-hash"
            data-mui-internal-clone-element="true"
            href="/c/my-cluster/"
          >
            Go to cluster
          </a>
        </div>
        <dl
          class="MuiGrid MuiGrid css-hash"
        >
          <dt
            class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
          >
            <div
              class="MuiBox css-hash"
            >
              <p
                class="MuiTypography MuiTypography css-hash"
                id="cluster-appearance-label"
              >
                Appearance
              </p>
              <p
                class="MuiTypography MuiTypography css-hash"
              >
                Stored in your browser's localStorage (per-browser setting).
              </p>
            </div>
          </dt>
          <dd
            class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
          >
            <div
              class="MuiBox css-hash"
            >
              <div
                class="MuiBox css-hash"
              >
                <span
                  class="MuiTypography MuiTypography css-hash"
                  id="accent-color-label"
                >
                  Accent color
                </span>
                <div
                  class="MuiBox css-hash"
                >
                  <button
                    aria-labelledby="cluster-appearance-label color-picker-button"
                    class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
                    id="color-picker-button"
                    tabindex="0"
                    type="button"
                  >
                    <span
                      class="MuiButton MuiButton MuiButton css-hash"
                    />
                    Choose Color
                    <span
                      class="MuiTouchRipple css-hash"
                    />
                  </button>
                </div>
              </div>
              <div
                class="MuiBox css-hash"
              >
                <span
                  class="MuiTypography MuiTypography css-hash"
                  id="cluster-icon-label"
                >
                  Cluster icon
                </span>
                <div
                  class="MuiBox css-hash"
                >
                  <button
                    aria-labelledby="cluster-appearance-label icon-picker-button"
                    class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
                    id="icon-picker-button"
                    tabindex="0"
                    type="button"
                  >
                    <span
                      class="MuiButton MuiButton MuiButton css-hash"
                    />
                    Choose Icon
                    <span
                      class="MuiTouchRipple css-hash"
                    />
                  </button>
                </div>
              </div>
            </div>
          </dd>
        </dl>
        <dl
          class="MuiGrid MuiGrid css-hash"
        >
          <dt
            class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
            id="default-namespace-label"
          >
            Default namespace
          </dt>
          <dd
            class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
          >
            <div
              class="MuiFormControl MuiTextField css-hash"
            >
              <div
                class="MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
              >
                <input
                  aria-describedby=":mock-test-id:"
                  aria-invalid="false"
                  aria-labelledby="default-namespace-label"
                  class="MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                  id=":mock-test-id:"
                  placeholder="default"
                  type="text"
                  value="default"
                />
                <fieldset
                  aria-hidden="true"
                  class="MuiOutlinedInput css-hash"
                >
                  <legend
                    class="css-hash"
                  >
                    <span
                      class="notranslate"
                    >
                      ​
                    </span>
                  </legend>
                </fieldset>
              </div>
              <p
                class="MuiFormHelperText MuiFormHelperText MuiFormHelperText MuiFormHelperText css-hash"
                id=":mock-test-id:"
              >
                The default namespace for e.g. when applying resources (when not specified directly).
              </p>
            </div>
          </dd>
          <dt
            class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
          >
            <p
              class="MuiTypography MuiTypography css-hash"
              id="allowed-namespace-label"
            >
              Allowed namespaces
            </p>
          </dt>
          <dd
            class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
          >
            <div
              class="MuiFormControl MuiTextField css-hash"
            >
              <div
                class="MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
              >
                <input
                  aria-describedby=":mock-test-id:"
                  aria-invalid="false"
                  aria-labelledby="allowed-namespace-label"
                  autocomplete="off"
                  class="MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                  form="[object Object]"
                  id=":mock-test-id:"
                  placeholder="Namespace"
                  type="text"
                  value=""
                />
                <button
                  aria-label="Add namespace"
                  class="Mui-disabled Mui-disabled MuiButtonBase MuiIconButton MuiIconButton css-hash"
                  disabled=""
                  tabindex="-1"
                  type="button"
                />
                <fieldset
                  aria-hidden="true"
                  class="MuiOutlinedInput css-hash"
                >
                  <legend
                    class="css-hash"
                  >
                    <span
                      class="notranslate"
                    >
                      ​
                    </span>
                  </legend>
                </fieldset>
              </div>
              <p
                class="MuiFormHelperText MuiFormHelperText MuiFormHelperText css-hash"
                id=":mock-test-id:"
              >
                The list of namespaces you are allowed to access in this cluster.
              </p>
            </div>
            <div
              class="MuiBox css-hash"
            >
              <div
                class="MuiButtonBase MuiChip MuiChip MuiChip MuiChip MuiChip MuiChip MuiChip css-hash"
                role="button"
                tabindex="0"
              >
                <span
                  class="MuiChip MuiChip css-hash"
                >
                  default
                </span>
                <svg
                  aria-hidden="true"
                  class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium MuiChip-deleteIcon MuiChip-deleteIconSmall MuiChip-deleteIconColorDefault MuiChip-deleteIconFilledColorDefault css-i4bv87-MuiSvgIcon-root"
                  data-testid="CancelIcon"
                  focusable="false"
                  viewBox="0 0 24 24"
                >
                  <path
                    d="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm5 13.59L15.59 17 12 13.41 8.41 17 7 15.59 10.59 12 7 8.41 8.41 7 12 10.59 15.59 7 17 8.41 13.41 12 17 15.59z"
                  />
                </svg>
              </div>
              <div
                class="MuiButtonBase MuiChip MuiChip MuiChip MuiChip MuiChip MuiChip MuiChip css-hash"
                role="button"
                tabindex="0"
              >
                <span
                  class="MuiChip MuiChip css-hash"
                >
                  kube-system
                </span>
                <svg
                  aria-hidden="true"
                  class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium MuiChip-deleteIcon MuiChip-deleteIconSmall MuiChip-deleteIconColorDefault MuiChip-deleteIconFilledColorDefault css-i4bv87-MuiSvgIcon-root"
                  data-testid="CancelIcon"
                  focusable="false"
                  viewBox="0 0 24 24"
                >
                  <path
                    d="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm5 13.59L15.59 17 12 13.41 8.41 17 7 15.59 10.59 12 7 8.41 8.41 7 12 10.59 15.59 7 17 8.41 13.41 12 17 15.59z"
                  />
                </svg>
              </div>
              <div
                class="MuiButtonBase MuiChip MuiChip MuiChip MuiChip MuiChip MuiChip MuiChip css-hash"
                role="button"
                tabindex="0"
              >
                <span
                  class="MuiChip MuiChip css-hash"
                >
                  monitoring
                </span>
                <svg
                  aria-hidden="true"
                  class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium MuiChip-deleteIcon MuiChip-deleteIconSmall MuiChip-deleteIconColorDefault MuiChip-deleteIconFilledColorDefault css-i4bv87-MuiSvgIcon-root"
                  data-testid="CancelIcon"
                  focusable="false"
                  viewBox="0 0 24 24"
                >
                  <path
                    d="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm5 13.59L15.59 17 12 13.41 8.41 17 7 15.59 10.59 12 7 8.41 8.41 7 12 10.59 15.59 7 17 8.41 13.41 12 17 15.59z"
                  />
                </svg>
              </div>
              <div
                class="MuiButtonBase MuiChip MuiChip MuiChip MuiChip MuiChip MuiChip MuiChip css-hash"
                role="button"
                tabindex="0"
              >
                <span
                  class="MuiChip MuiChip css-hash"
                >
                  logging
                </span>
                <svg
                  aria-hidden="true"
                  class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium MuiChip-deleteIcon MuiChip-deleteIconSmall MuiChip-deleteIconColorDefault MuiChip-deleteIconFilledColorDefault css-i4bv87-MuiSvgIcon-root"
                  data-testid="CancelIcon"
                  focusable="false"
                  viewBox="0 0 24 24"
                >
                  <path
                    d="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm5 13.59L15.59 17 12 13.41 8.41 17 7 15.59 10.59 12 7 8.41 8.41 7 12 10.59 15.59 7 17 8.41 13.41 12 17 15.59z"
                  />
                </svg>
              </div>
              <div
                class="MuiButtonBase MuiChip MuiChip MuiChip MuiChip MuiChip MuiChip MuiChip css-hash"
                role="button"
                tabindex="0"
              >
                <span
                  class="MuiChip MuiChip css-hash"
                >
                  ingress-nginx
                </span>
                <svg
                  aria-hidden="true"
                  class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium MuiChip-deleteIcon MuiChip-deleteIconSmall MuiChip-deleteIconColorDefault MuiChip-deleteIconFilledColorDefault css-i4bv87-MuiSvgIcon-root"
                  data-testid="CancelIcon"
                  focusable="false"
                  viewBox="0 0 24 24"
                >
                  <path
                    d="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm5 13.59L15.59 17 12 13.41 8.41 17 7 15.59 10.59 12 7 8.41 8.41 7 12 10.59 15.59 7 17 8.41 13.41 12 17 15.59z"
                  />
                </svg>
              </div>
              <div
                class="MuiButtonBase MuiChip MuiChip MuiChip MuiChip MuiChip MuiChip MuiChip css-hash"
                role="button"
                tabindex="0"
              >
                <span
                  class="MuiChip MuiChip css-hash"
                >
                  cert-manager
                </span>
                <svg
                  aria-hidden="true"
                  class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium MuiChip-deleteIcon MuiChip-deleteIconSmall MuiChip-deleteIconColorDefault MuiChip-deleteIconFilledColorDefault css-i4bv87-MuiSvgIcon-root"
                  data-testid="CancelIcon"
                  focusable="false"
                  viewBox="0 0 24 24"
                >
                  <path
                    d="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm5 13.59L15.59 17 12 13.41 8.41 17 7 15.59 10.59 12 7 8.41 8.41 7 12 10.59 15.59 7 17 8.41 13.41 12 17 15.59z"
                  />
                </svg>
              </div>
            </div>
          </dd>
        </dl>
      </div>
    </div>
    <div
      class="MuiBox css-hash"
    >
      <div
        class="MuiGrid MuiGrid MuiGrid css-hash"
      >
        <div
          class="MuiGrid MuiGrid css-hash"
        >
          <div
            class="MuiBox css-hash"
          >
            <h4
              class="MuiTypography MuiTypography MuiTypography css-hash"
            >
              Node Shell Settings
            </h4>
            <div
              class="MuiBox css-hash"
            />
          </div>
        </div>
      </div>
      <div
        class="MuiBox css-hash"
      >
        <dl
          class="MuiGrid MuiGrid css-hash"
        >
          <dt
            class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
          >
            <p
              class="MuiTypography MuiTypography css-hash"
              id="node-shell-enabled-label"
            >
              Enable Node Shell
            </p>
          </dt>
          <dd
            class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
          >
            <span
              class="MuiSwitch MuiSwitch css-hash"
            >
              <span
                class="Mui-checked Mui-checked Mui-checked MuiButtonBase MuiSwitch MuiSwitch MuiSwitch MuiSwitch PrivateSwitchBase-root css-hash"
              >
                <input
                  aria-labelledby="node-shell-enabled-label"
                  checked=""
                  class="MuiSwitch PrivateSwitchBase-input css-hash"
                  type="checkbox"
                />
                <span
                  class="MuiSwitch css-hash"
                />
                <span
                  class="MuiTouchRipple css-hash"
                />
              </span>
              <span
                class="MuiSwitch css-hash"
              />
            </span>
          </dd>
          <dt
            class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
          >
            Linux Image
          </dt>
          <dd
            class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
          >
            <div
              class="MuiFormControl MuiTextField css-hash"
            >
              <div
                class="MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
              >
                <input
                  aria-describedby=":mock-test-id:"
                  aria-invalid="false"
                  aria-label="Linux image"
                  class="MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                  id=":mock-test-id:"
                  placeholder="docker.io/library/busybox:latest"
                  type="text"
                  value=""
                />
                <fieldset
                  aria-hidden="true"
                  class="MuiOutlinedInput css-hash"
                >
                  <legend
                    class="css-hash"
                  >
                    <span
                      class="notranslate"
                    >
                      ​
                    </span>
                  </legend>
                </fieldset>
              </div>
              <p
                class="MuiFormHelperText MuiFormHelperText MuiFormHelperText css-hash"
                id=":mock-test-id:"
              >
                The default image is used for dropping a shell into a node (when not specified directly).
              </p>
            </div>
          </dd>
          <dt
            class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
          >
            Namespace
          </dt>
          <dd
            class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
          >
            <div
              class="MuiFormControl MuiTextField css-hash"
            >
              <div
                class="MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
              >
                <input
                  aria-describedby=":mock-test-id:"
                  aria-invalid="false"
                  aria-label="Namespace"
                  class="MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                  id=":mock-test-id:"
                  placeholder="default"
                  type="text"
                  value=""
                />
                <fieldset
                  aria-hidden="true"
                  class="MuiOutlinedInput css-hash"
                >
                  <legend
                    class="css-hash"
                  >
                    <span
                      class="notranslate"
                    >
                      ​
                    </span>
                  </legend>
                </fieldset>
              </div>
              <p
                class="MuiFormHelperText MuiFormHelperText MuiFormHelperText css-hash"
                id=":mock-test-id:"
              >
                The default namespace is default.
              </p>
            </div>
          </dd>
        </dl>
      </div>
    </div>
    <div
      class="MuiBox css-hash"
    >
      <div
        class="MuiGrid MuiGrid MuiGrid css-hash"
      >
        <div
          class="MuiGrid MuiGrid css-hash"
        >
          <div
            class="MuiBox css-hash"
          >
            <h4
              class="MuiTypography MuiTypography MuiTypography css-hash"
            >
              Pod Debug Settings
            </h4>
            <div
              class="MuiBox css-hash"
            />
          </div>
        </div>
      </div>
      <div
        class="MuiBox css-hash"
      >
        <dl
          class="MuiGrid MuiGrid css-hash"
        >
          <dt
            class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
          >
            <p
              aria-label="Ephemeral debug containers cannot be removed via Kubernetes API. They will remain in the pod specification even after the terminal closes. To remove them, the pod must be recreated."
              class="MuiTypography MuiTypography css-hash"
              data-mui-internal-clone-element="true"
            >
              <span
                id="pod-debug-enabled-label"
              >
                Enable Pod Debug
              </span>
            </p>
          </dt>
          <dd
            class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
          >
            <span
              class="MuiSwitch MuiSwitch css-hash"
            >
              <span
                class="Mui-checked Mui-checked Mui-checked MuiButtonBase MuiSwitch MuiSwitch MuiSwitch MuiSwitch PrivateSwitchBase-root css-hash"
              >
                <input
                  aria-labelledby="pod-debug-enabled-label"
                  checked=""
                  class="MuiSwitch PrivateSwitchBase-input css-hash"
                  type="checkbox"
                />
                <span
                  class="MuiSwitch css-hash"
                />
                <span
                  class="MuiTouchRipple css-hash"
                />
              </span>
              <span
                class="MuiSwitch css-hash"
              />
            </span>
          </dd>
          <dt
            class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
          >
            Debug Image
          </dt>
          <dd
            class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
          >
            <div
              class="MuiFormControl MuiTextField css-hash"
            >
              <div
                class="MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
              >
                <input
                  aria-describedby=":mock-test-id:"
                  aria-invalid="false"
                  class="MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                  id=":mock-test-id:"
                  placeholder="docker.io/library/busybox:latest"
                  type="text"
                  value=""
                />
                <fieldset
                  aria-hidden="true"
                  class="MuiOutlinedInput css-hash"
                >
                  <legend
                    class="css-hash"
                  >
                    <span
                      class="notranslate"
                    >
                      ​
                    </span>
                  </legend>
                </fieldset>
              </div>
              <p
                class="MuiFormHelperText MuiFormHelperText MuiFormHelperText css-hash"
                id=":mock-test-id:"
              >
                The default image is used for creating ephemeral debug containers.
              </p>
            </div>
          </dd>
        </dl>
      </div>
    </div>
  </div>
</body>