<body>
  <div
    aria-hidden="true"
  />
  <div
    class="MuiDialog MuiModal css-hash"
    role="presentation"
  >
    <div
      aria-hidden="true"
      class="MuiBackdrop MuiModal css-hash"
      style="opacity: 1; transition: opacity 225ms cubic-bezier(0.4, 0, 0.2, 1) 0ms;"
    />
    <div
      data-testid="sentinelStart"
      tabindex="0"
    />
    <div
      class="MuiDialog MuiDialog css-hash"
      role="presentation"
      style="opacity: 1; transition: opacity 225ms cubic-bezier(0.4, 0, 0.2, 1) 0ms;"
      tabindex="-1"
    >
      <div
        aria-labelledby=":mock-test-id:"
        class="MuiDialog MuiDialog MuiDialog MuiPaper MuiPaper MuiPaper css-hash"
        role="dialog"
      >
        <h2
          class="MuiDialogTitle MuiTypography MuiTypography css-hash"
          id=":mock-test-id:"
        >
          Choose Cluster Icon
        </h2>
        <div
          class="MuiDialogContent css-hash"
        >
          <div
            class="MuiBox css-hash"
          >
            <div
              class="MuiBox css-hash"
            >
              <button
                aria-label="Kubernetes"
                aria-pressed="true"
                class="Mui-selected MuiButtonBase MuiToggleButton MuiToggleButton MuiToggleButton css-hash"
                data-mui-internal-clone-element="true"
                tabindex="0"
                type="button"
                value="mdi:kubernetes"
              >
                <span
                  class="MuiTouchRipple css-hash"
                />
              </button>
              <button
                aria-label="Alert Circle"
                aria-pressed="false"
                class="MuiButtonBase MuiToggleButton MuiToggleButton MuiToggleButton css-hash"
                data-mui-internal-clone-element="true"
                tabindex="0"
                type="button"
                value="mdi:alert-circle"
              >
                <span
                  class="MuiTouchRipple css-hash"
                />
              </button>
              <button
                aria-label="Shield Alert"
                aria-pressed="false"
                class="MuiButtonBase MuiToggleButton MuiToggleButton MuiToggleButton css-hash"
                data-mui-internal-clone-element="true"
                tabindex="0"
                type="button"
                value="mdi:shield-alert"
              >
                <span
                  class="MuiTouchRipple css-hash"
                />
              </button>
              <button
                aria-label="Server"
                aria-pressed="false"
                class="MuiButtonBase MuiToggleButton MuiToggleButton MuiToggleButton css-hash"
                data-mui-internal-clone-element="true"
                tabindex="0"
                type="button"
                value="mdi:server"
              >
                <span
                  class="MuiTouchRipple css-hash"
                />
              </button>
              <button
                aria-label="Code Tags"
                aria-pressed="false"
                class="MuiButtonBase MuiToggleButton MuiToggleButton MuiToggleButton css-hash"
                data-mui-internal-clone-element="true"
                tabindex="0"
                type="button"
                value="mdi:code-tags"
              >
                <span
                  class="MuiTouchRipple css-hash"
                />
              </button>
              <button
                aria-label="Test Tube"
                aria-pressed="false"
                class="MuiButtonBase MuiToggleButton MuiToggleButton MuiToggleButton css-hash"
                data-mui-internal-clone-element="true"
                tabindex="0"
                type="button"
                value="mdi:test-tube"
              >
                <span
                  class="MuiTouchRipple css-hash"
                />
              </button>
              <button
                aria-label="Rocket"
                aria-pressed="false"
                class="MuiButtonBase MuiToggleButton MuiToggleButton MuiToggleButton css-hash"
                data-mui-internal-clone-element="true"
                tabindex="0"
                type="button"
                value="mdi:rocket-launch-outline"
              >
                <span
                  class="MuiTouchRipple css-hash"
                />
              </button>
              <button
                aria-label="Cloud"
                aria-pressed="false"
                class="MuiButtonBase MuiToggleButton MuiToggleButton MuiToggleButton css-hash"
                data-mui-internal-clone-element="true"
                tabindex="0"
                type="button"
                value="mdi:cloud-outline"
              >
                <span
                  class="MuiTouchRipple css-hash"
                />
              </button>
              <button
                aria-label="Database"
                aria-pressed="false"
                class="MuiButtonBase MuiToggleButton MuiToggleButton MuiToggleButton css-hash"
                data-mui-internal-clone-element="true"
                tabindex="0"
                type="button"
                value="mdi:database"
              >
                <span
                  class="MuiTouchRipple css-hash"
                />
              </button>
              <button
                aria-label="Hexagon Multiple"
                aria-pressed="false"
                class="MuiButtonBase MuiToggleButton MuiToggleButton MuiToggleButton css-hash"
                data-mui-internal-clone-element="true"
                tabindex="0"
                type="button"
                value="mdi:hexagon-multiple-outline"
              >
                <span
                  class="MuiTouchRipple css-hash"
                />
              </button>
              <button
                aria-label="Lock"
                aria-pressed="false"
                class="MuiButtonBase MuiToggleButton MuiToggleButton MuiToggleButton css-hash"
                data-mui-internal-clone-element="true"
                tabindex="0"
                type="button"
                value="mdi:lock"
              >
                <span
                  class="MuiTouchRipple css-hash"
                />
              </button>
              <button
                aria-label="Key"
                aria-pressed="false"
                class="MuiButtonBase MuiToggleButton MuiToggleButton MuiToggleButton css-hash"
                data-mui-internal-clone-element="true"
                tabindex="0"
                type="button"
                value="mdi:shield-key"
              >
                <span
                  class="MuiTouchRipple css-hash"
                />
              </button>
              <button
                aria-label="Lightning"
                aria-pressed="false"
                class="MuiButtonBase MuiToggleButton MuiToggleButton MuiToggleButton css-hash"
                data-mui-internal-clone-element="true"
                tabindex="0"
                type="button"
                value="mdi:lightning-bolt-circle"
              >
                <span
                  class="MuiTouchRipple css-hash"
                />
              </button>
              <button
                aria-label="Star"
                aria-pressed="false"
                class="MuiButtonBase MuiToggleButton MuiToggleButton MuiToggleButton css-hash"
                data-mui-internal-clone-element="true"
                tabindex="0"
                type="button"
                value="mdi:star"
              >
                <span
                  class="MuiTouchRipple css-hash"
                />
              </button>
              <button
                aria-label="Presentation"
                aria-pressed="false"
                class="MuiButtonBase MuiToggleButton MuiToggleButton MuiToggleButton css-hash"
                data-mui-internal-clone-element="true"
                tabindex="0"
                type="button"
                value="mdi:presentation"
              >
                <span
                  class="MuiTouchRipple css-hash"
                />
              </button>
            </div>
          </div>
          <div
            class="MuiBox css-hash"
          >
            <label
              class="MuiFormControlLabel MuiFormControlLabel css-hash"
            >
              <span
                class="MuiButtonBase MuiCheckbox MuiCheckbox MuiCheckbox MuiCheckbox MuiCheckbox MuiCheckbox MuiCheckbox MuiCheckbox MuiCheckbox PrivateSwitchBase-root css-hash"
              >
                <input
                  class="PrivateSwitchBase-input css-hash"
                  data-indeterminate="false"
                  type="checkbox"
                />
                <svg
                  aria-hidden="true"
                  class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium css-i4bv87-MuiSvgIcon-root"
                  data-testid="CheckBoxOutlineBlankIcon"
                  focusable="false"
                  viewBox="0 0 24 24"
                >
                  <path
                    d="M19 5v14H5V5h14m0-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"
                  />
                </svg>
                <span
                  class="MuiTouchRipple css-hash"
                />
              </span>
              <span
                class="MuiFormControlLabel MuiTypography MuiTypography css-hash"
              >
                Use custom icon
              </span>
            </label>
          </div>
        </div>
        <div
          class="MuiDialogActions MuiDialogActions css-hash"
        >
          <button
            class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
            tabindex="0"
            type="button"
          >
            Cancel
            <span
              class="MuiTouchRipple css-hash"
            />
          </button>
        </div>
      </div>
    </div>
    <div
      data-testid="sentinelEnd"
      tabindex="0"
    />
  </div>
</body>