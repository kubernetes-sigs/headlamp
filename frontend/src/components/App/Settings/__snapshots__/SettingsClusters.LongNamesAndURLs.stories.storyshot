<body>
  <div>
    <div
      class="MuiBox css-hash"
    >
      <div
        class="MuiGrid MuiGrid MuiGrid css-hash"
      >
        <div
          class="MuiGrid MuiGrid css-hash"
        >
          <div
            class="MuiBox css-hash"
          >
            <h2
              class="MuiTypography MuiTypography MuiTypography css-hash"
            >
              Cluster Settings
            </h2>
            <div
              class="MuiBox css-hash"
            />
          </div>
        </div>
      </div>
      <div
        class="MuiBox css-hash"
      >
        <div
          aria-atomic="true"
          aria-live="polite"
          class="MuiBox css-hash"
          role="status"
        />
        <div
          class="MuiPaper MuiPaper MuiPaper MuiTableContainer css-hash"
          tabindex="0"
        >
          <table
            class="MuiTable css-hash"
          >
            <thead
              class="MuiTableHead css-hash"
            >
              <tr
                class="MuiTableRow MuiTableRow css-hash"
              >
                <th
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                  scope="col"
                >
                  Name
                </th>
                <th
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                  scope="col"
                >
                  Server
                </th>
              </tr>
            </thead>
            <tbody
              class="MuiTableBody css-hash"
            >
              <tr
                class="MuiTableRow css-hash"
              >
                <td
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                >
                  <a
                    class="MuiLink MuiLink MuiTypography MuiTypography css-hash"
                    href="/settings/cluster?c=very-long-production-cluster-name-for-enterprise-deployment"
                  >
                    very-long-production-cluster-name-for-enterprise-deployment
                  </a>
                </td>
                <td
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                >
                  https://very-long-subdomain-name-for-kubernetes-api-server.production.enterprise.example.com:6443
                </td>
              </tr>
              <tr
                class="MuiTableRow css-hash"
              >
                <td
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                >
                  <a
                    class="MuiLink MuiLink MuiTypography MuiTypography css-hash"
                    href="/settings/cluster?c=another-extremely-long-cluster-identifier-with-multiple-hyphens"
                  >
                    another-extremely-long-cluster-identifier-with-multiple-hyphens
                  </a>
                </td>
                <td
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                >
                  https://another-very-long-server-url.staging.corporate.example.org:8443
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</body>