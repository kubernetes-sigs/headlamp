<body>
  <div>
    <dl
      class="MuiGrid MuiGrid css-hash"
    >
      <dt
        class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
        id="cluster-name-label"
      >
        <p
          class="MuiTypography MuiTypography css-hash"
        >
          Name
        </p>
        <div />
      </dt>
      <dd
        class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
      >
        <div
          class="MuiFormControl MuiTextField css-hash"
        >
          <div
            class="MuiInput MuiInput MuiInputBase MuiInputBase MuiInputBase MuiInputBase css-hash"
          >
            <input
              aria-invalid="false"
              aria-labelledby="cluster-name-label"
              autocomplete="off"
              class="MuiInput MuiInputBase MuiInputBase css-hash"
              id=":mock-test-id:"
              placeholder="my-cluster"
              type="text"
              value=""
            />
            <div
              class="MuiBox css-hash"
            >
              <button
                class="Mui-disabled MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
                disabled=""
                tabindex="-1"
                type="button"
              >
                Apply
              </button>
              <div />
            </div>
          </div>
          <p
            class="MuiFormHelperText MuiFormHelperText css-hash"
            id=":mock-test-id:"
          >
            <p
              class="MuiTypography MuiTypography css-hash"
            >
              The current name of the cluster. You can define a custom name
            </p>
          </p>
        </div>
      </dd>
    </dl>
  </div>
</body>