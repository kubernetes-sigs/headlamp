<body>
  <div>
    <div
      class="MuiBox css-hash"
    >
      <div
        class="MuiGrid MuiGrid MuiGrid css-hash"
      >
        <div
          class="MuiGrid MuiGrid css-hash"
        >
          <div
            class="MuiBox css-hash"
          >
            <h2
              class="MuiTypography MuiTypography MuiTypography css-hash"
            >
              Cluster Settings
            </h2>
            <div
              class="MuiBox css-hash"
            />
          </div>
        </div>
      </div>
      <div
        class="MuiBox css-hash"
      >
        <div
          aria-atomic="true"
          aria-live="polite"
          class="MuiBox css-hash"
          role="status"
        />
        <div
          class="MuiPaper MuiPaper MuiPaper MuiTableContainer css-hash"
          tabindex="0"
        >
          <table
            class="MuiTable css-hash"
          >
            <thead
              class="MuiTableHead css-hash"
            >
              <tr
                class="MuiTableRow MuiTableRow css-hash"
              >
                <th
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                  scope="col"
                >
                  Name
                </th>
                <th
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                  scope="col"
                >
                  Server
                </th>
              </tr>
            </thead>
            <tbody
              class="MuiTableBody css-hash"
            >
              <tr
                class="MuiTableRow css-hash"
              >
                <td
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                >
                  <a
                    class="MuiLink MuiLink MuiTypography MuiTypography css-hash"
                    href="/settings/cluster?c=local-kind"
                  >
                    local-kind
                  </a>
                </td>
                <td
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                >
                  https://127.0.0.1:6443
                </td>
              </tr>
              <tr
                class="MuiTableRow css-hash"
              >
                <td
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                >
                  <a
                    class="MuiLink MuiLink MuiTypography MuiTypography css-hash"
                    href="/settings/cluster?c=minikube"
                  >
                    minikube
                  </a>
                </td>
                <td
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                >
                  https://192.168.49.2:8443
                </td>
              </tr>
              <tr
                class="MuiTableRow css-hash"
              >
                <td
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                >
                  <a
                    class="MuiLink MuiLink MuiTypography MuiTypography css-hash"
                    href="/settings/cluster?c=eks-cluster"
                  >
                    eks-cluster
                  </a>
                </td>
                <td
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                >
                  https://ABC123DEF456.gr7.us-west-2.eks.amazonaws.com
                </td>
              </tr>
              <tr
                class="MuiTableRow css-hash"
              >
                <td
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                >
                  <a
                    class="MuiLink MuiLink MuiTypography MuiTypography css-hash"
                    href="/settings/cluster?c=gke-cluster"
                  >
                    gke-cluster
                  </a>
                </td>
                <td
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                >
                  https://34.123.45.67
                </td>
              </tr>
              <tr
                class="MuiTableRow css-hash"
              >
                <td
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                >
                  <a
                    class="MuiLink MuiLink MuiTypography MuiTypography css-hash"
                    href="/settings/cluster?c=aks-cluster"
                  >
                    aks-cluster
                  </a>
                </td>
                <td
                  class="MuiTableCell MuiTableCell MuiTableCell css-hash"
                >
                  https://myaks-dns-12345678.hcp.eastus.azmk8s.io:443
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</body>