<body>
  <div
    aria-hidden="true"
  />
  <div
    class="MuiDialog MuiModal css-hash"
    role="presentation"
  >
    <div
      aria-hidden="true"
      class="MuiBackdrop MuiModal css-hash"
      style="opacity: 1; transition: opacity 225ms cubic-bezier(0.4, 0, 0.2, 1) 0ms;"
    />
    <div
      data-testid="sentinelStart"
      tabindex="0"
    />
    <div
      class="MuiDialog MuiDialog css-hash"
      role="presentation"
      style="opacity: 1; transition: opacity 225ms cubic-bezier(0.4, 0, 0.2, 1) 0ms;"
      tabindex="-1"
    >
      <div
        aria-labelledby=":mock-test-id:"
        class="MuiDialog MuiDialog MuiDialog MuiDialog MuiPaper MuiPaper MuiPaper css-hash"
        role="dialog"
      >
        <h2
          class="MuiDialogTitle MuiTypography MuiTypography css-hash"
          id=":mock-test-id:"
          style="display: flex;"
        >
          <div
            class="MuiGrid MuiGrid css-hash"
          >
            <div
              class="MuiGrid MuiGrid css-hash"
            >
              <h1
                class="MuiTypography MuiTypography css-hash"
                id=":mock-test-id:"
                style="font-size: 1.25rem; font-weight: 500; line-height: 1.6;"
                tabindex="-1"
              >
                Keyboard Shortcuts
              </h1>
            </div>
            <div
              class="MuiGrid MuiGrid css-hash"
            >
              <div
                class="MuiBox css-hash"
              >
                <button
                  aria-label="Close"
                  class="MuiButtonBase MuiIconButton MuiIconButton css-hash"
                  data-mui-internal-clone-element="true"
                  tabindex="0"
                  type="button"
                >
                  <span
                    class="MuiTouchRipple css-hash"
                  />
                </button>
              </div>
            </div>
          </div>
        </h2>
        <div
          class="MuiDialogContent css-hash"
        >
          <div
            class="MuiBox css-hash"
          >
            <div
              class="MuiBox css-hash"
            >
              <dl
                class="MuiGrid MuiGrid css-hash"
              >
                <dt
                  class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
                >
                  <span
                    class="MuiTypography MuiTypography css-hash"
                  >
                    Search
                  </span>
                </dt>
                <dt
                  class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
                >
                  <div
                    class="MuiBox css-hash"
                  >
                    <p
                      class="MuiTypography MuiTypography css-hash"
                    >
                      Global Search
                    </p>
                    <span
                      class="MuiTypography MuiTypography css-hash"
                    >
                      Open the global search dialog
                    </span>
                  </div>
                </dt>
                <dd
                  class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
                >
                  <div
                    class="MuiBox css-hash"
                  >
                    <button
                      class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
                      tabindex="0"
                      type="button"
                    >
                      /
                      <span
                        class="MuiTouchRipple css-hash"
                      />
                    </button>
                  </div>
                </dd>
                <dt
                  class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
                >
                  <div
                    class="MuiBox css-hash"
                  >
                    <p
                      class="MuiTypography MuiTypography css-hash"
                    >
                      Log Viewer Search
                    </p>
                    <span
                      class="MuiTypography MuiTypography css-hash"
                    >
                      Toggle search in log viewer
                    </span>
                  </div>
                </dt>
                <dd
                  class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
                >
                  <div
                    class="MuiBox css-hash"
                  >
                    <button
                      class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
                      tabindex="0"
                      type="button"
                    >
                      Ctrl + Shift + F
                      <span
                        class="MuiTouchRipple css-hash"
                      />
                    </button>
                  </div>
                </dd>
                <dt
                  class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
                >
                  <span
                    class="MuiTypography MuiTypography css-hash"
                  >
                    Navigation
                  </span>
                </dt>
                <dt
                  class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
                >
                  <div
                    class="MuiBox css-hash"
                  >
                    <p
                      class="MuiTypography MuiTypography css-hash"
                    >
                      Cluster Chooser
                    </p>
                    <span
                      class="MuiTypography MuiTypography css-hash"
                    >
                      Open the cluster chooser popup
                    </span>
                  </div>
                </dt>
                <dd
                  class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
                >
                  <div
                    class="MuiBox css-hash"
                  >
                    <button
                      class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
                      tabindex="0"
                      type="button"
                    >
                      Ctrl + Shift + L
                      <span
                        class="MuiTouchRipple css-hash"
                      />
                    </button>
                  </div>
                </dd>
                <dt
                  class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
                >
                  <span
                    class="MuiTypography MuiTypography css-hash"
                  >
                    General
                  </span>
                </dt>
                <dt
                  class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
                >
                  <div
                    class="MuiBox css-hash"
                  >
                    <p
                      class="MuiTypography MuiTypography css-hash"
                    >
                      Toggle Table Filters
                    </p>
                    <span
                      class="MuiTypography MuiTypography css-hash"
                    >
                      Toggle column filters in tables
                    </span>
                  </div>
                </dt>
                <dd
                  class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
                >
                  <div
                    class="MuiBox css-hash"
                  >
                    <button
                      class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
                      tabindex="0"
                      type="button"
                    >
                      Alt + Shift + T
                      <span
                        class="MuiTouchRipple css-hash"
                      />
                    </button>
                  </div>
                </dd>
              </dl>
            </div>
          </div>
        </div>
        <div
          class="MuiDialogActions MuiDialogActions css-hash"
        >
          <button
            class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
            tabindex="0"
            type="button"
          >
            <span
              class="MuiButton MuiButton MuiButton css-hash"
            />
            Reset All to Defaults
            <span
              class="MuiTouchRipple css-hash"
            />
          </button>
          <button
            class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
            tabindex="0"
            type="button"
          >
            Close
            <span
              class="MuiTouchRipple css-hash"
            />
          </button>
        </div>
      </div>
    </div>
    <div
      data-testid="sentinelEnd"
      tabindex="0"
    />
  </div>
</body>