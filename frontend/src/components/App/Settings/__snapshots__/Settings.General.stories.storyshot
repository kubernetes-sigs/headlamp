<body>
  <div>
    <button
      class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
      tabindex="0"
      type="button"
    >
      <span
        class="MuiButton MuiButton MuiButton css-hash"
      />
      <p
        class="MuiTypography MuiTypography css-hash"
        style="padding-top: 3px;"
      >
        Back
      </p>
      <span
        class="MuiTouchRipple css-hash"
      />
    </button>
    <div
      class="MuiBox css-hash"
    >
      <div
        class="MuiGrid MuiGrid MuiGrid css-hash"
      >
        <div
          class="MuiGrid MuiGrid css-hash"
        >
          <div
            class="MuiBox css-hash"
          >
            <h1
              class="MuiTypography MuiTypography MuiTypography css-hash"
            >
              General Settings
            </h1>
            <div
              class="MuiBox css-hash"
            />
          </div>
        </div>
        <div
          class="MuiGrid MuiGrid css-hash"
        >
          <div
            class="MuiGrid MuiGrid MuiGrid css-hash"
          >
            <div
              class="MuiGrid MuiGrid css-hash"
            >
              <button
                aria-label="Version"
                class="MuiButtonBase MuiIconButton MuiIconButton css-hash"
                data-mui-internal-clone-element="true"
                tabindex="0"
                type="button"
              >
                <span
                  class="MuiTouchRipple css-hash"
                />
              </button>
            </div>
          </div>
        </div>
      </div>
      <div
        class="MuiBox css-hash"
      >
        <dl
          class="MuiGrid MuiGrid css-hash"
        >
          <dt
            class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
          >
            Language
          </dt>
          <dd
            class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
          >
            <div
              class="MuiFormControl css-hash"
            >
              <div
                class="MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
              >
                <div
                  aria-controls="under-test"
                  aria-expanded="false"
                  aria-haspopup="listbox"
                  aria-label="Select locale"
                  class="MuiInputBase MuiInputBase MuiOutlinedInput MuiSelect MuiSelect css-hash"
                  role="combobox"
                  tabindex="0"
                >
                  English
                </div>
                <input
                  aria-controls="under-test"
                  aria-hidden="true"
                  aria-invalid="false"
                  class="MuiSelect css-hash"
                  tabindex="-1"
                  value="en"
                />
                <svg
                  aria-hidden="true"
                  class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium MuiSelect-icon MuiSelect-iconOutlined css-hfutr2-MuiSvgIcon-root-MuiSelect-icon"
                  data-testid="ArrowDropDownIcon"
                  focusable="false"
                  viewBox="0 0 24 24"
                >
                  <path
                    d="M7 10l5 5 5-5z"
                  />
                </svg>
                <fieldset
                  aria-hidden="true"
                  class="MuiOutlinedInput css-hash"
                >
                  <legend
                    class="css-hash"
                  >
                    <span
                      class="notranslate"
                    >
                      ​
                    </span>
                  </legend>
                </fieldset>
              </div>
            </div>
          </dd>
          <dt
            class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
          >
            Resource details view
          </dt>
          <dd
            class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
          >
            <div
              class="MuiBox css-hash"
            >
              <button
                aria-pressed="true"
                class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
                tabindex="0"
                type="button"
              >
                <div
                  class="MuiBox css-hash"
                >
                  <div
                    class="MuiBox css-hash"
                  />
                  <div
                    class="MuiBox css-hash"
                  />
                  <div
                    class="MuiBox css-hash"
                  >
                    <div
                      class="MuiBox css-hash"
                    />
                  </div>
                </div>
                Window
                <span
                  class="MuiTouchRipple css-hash"
                />
              </button>
              <button
                aria-pressed="false"
                class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
                tabindex="0"
                type="button"
              >
                <div
                  class="MuiBox css-hash"
                >
                  <div
                    class="MuiBox css-hash"
                  />
                  <div
                    class="MuiBox css-hash"
                  />
                  <div
