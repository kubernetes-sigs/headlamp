                      aria-describedby="timezone-selector-autocomplete-helper-text"
                      aria-expanded="false"
                      aria-invalid="false"
                      aria-labelledby="timezone-label"
                      autocapitalize="none"
                      autocomplete="off"
                      class="MuiAutocomplete MuiAutocomplete MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                      id="timezone-selector-autocomplete"
                      role="combobox"
                      spellcheck="false"
                      type="text"
                      value="(UTC+0) UTC"
                    />
                    <div
                      class="MuiAutocomplete css-hash"
                    >
                      <button
                        aria-label="Open"
                        class="MuiAutocomplete MuiButtonBase MuiIconButton MuiIconButton css-hash"
                        tabindex="-1"
                        title="Open"
                        type="button"
                      >
                        <svg
                          aria-hidden="true"
                          class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium css-i4bv87-MuiSvgIcon-root"
                          data-testid="ArrowDropDownIcon"
                          focusable="false"
                          viewBox="0 0 24 24"
                        >
                          <path
                            d="M7 10l5 5 5-5z"
                          />
                        </svg>
                        <span
                          class="MuiTouchRipple css-hash"
                        />
