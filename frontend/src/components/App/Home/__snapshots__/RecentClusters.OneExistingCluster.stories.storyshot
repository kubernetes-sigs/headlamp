<body>
  <div>
    <div
      aria-labelledby="recent-clusters-label"
      class="MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
      role="group"
    >
      <div
        class="MuiGrid MuiGrid css-hash"
      >
        <button
          class="Mui-focusVisible MuiButtonBase css-hash"
          tabindex="0"
          type="button"
        >
          <div
            class="MuiCard MuiPaper MuiPaper MuiPaper css-hash"
          >
            <div
              class="MuiCardContent css-hash"
            >
              <p
                aria-label="cluster0"
                class="MuiTypography MuiTypography MuiTypography css-hash"
                data-mui-internal-clone-element="true"
              >
                cluster0
              </p>
            </div>
          </div>
          <span
            class="MuiTouchRipple css-hash"
          >
            <span
              class="MuiTouchRipple MuiTouchRipple MuiTouchRipple css-hash"
              style="width: 1px; height: 1px; top: -0.5px; left: -0.5px;"
            >
              <span
                class="MuiTouchRipple MuiTouchRipple"
              />
            </span>
          </span>
        </button>
      </div>
    </div>
  </div>
</body>