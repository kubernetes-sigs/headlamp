        class="MuiGrid MuiGrid MuiGrid css-hash"
      >
        <div
          aria-label="Selected clusters"
          class="MuiToggleButtonGroup css-hash"
          role="group"
        >
          <button
            aria-pressed="false"
            class="MuiButtonBase MuiToggleButton MuiToggleButton MuiToggleButton MuiToggleButtonGroup MuiToggleButtonGroup MuiToggleButtonGroup css-hash"
            tabindex="0"
            type="button"
            value="[object Object]"
          >
            cluster0
            <span
              class="MuiTouchRipple css-hash"
            />
          </button>
          <button
            aria-pressed="false"
            class="MuiButtonBase MuiToggleButton MuiToggleButton MuiToggleButton MuiToggleButtonGroup MuiToggleButtonGroup MuiToggleButtonGroup css-hash"
            tabindex="0"
            type="button"
            value="[object Object]"
          >
            cluster1
            <span
              class="MuiTouchRipple css-hash"
            />
          </button>
          <button
            aria-pressed="false"
            class="MuiButtonBase MuiToggleButton MuiToggleButton MuiToggleButton MuiToggleButtonGroup MuiToggleButtonGroup MuiToggleButtonGroup css-hash"
            tabindex="0"
            type="button"
            value="[object Object]"
          >
            cluster2
            <span
              class="MuiTouchRipple css-hash"
            />
          </button>
        </div>
        <div
          class="MuiGrid MuiGrid css-hash"
        >
          <button
            class="Mui-disabled MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
            disabled=""
            tabindex="-1"
            type="button"
          >
            View
          </button>
        </div>
      </div>
    </div>
  </div>
</body>