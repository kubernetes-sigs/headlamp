<body>
  <div>
    <div
      class="MuiGrid MuiGrid MuiGrid css-hash"
    >
      <div
        class="MuiGrid MuiGrid MuiGrid css-hash"
      >
        <div
          class="MuiBox css-hash"
        >
          <div
            class="MuiBox css-hash"
          >
            <div
              class="MuiGrid MuiGrid MuiGrid css-hash"
            >
              <div
                class="MuiGrid MuiGrid css-hash"
              >
                <div
                  class="MuiBox css-hash"
                >
                  <h1
                    class="MuiTypography MuiTypography MuiTypography css-hash"
                  >
                    Home
                  </h1>
                  <div
                    class="MuiBox css-hash"
                  />
                </div>
              </div>
            </div>
            <div
              class="MuiBox css-hash"
            >
              <div
                class="MuiBox css-hash"
              >
                <div
                  class="MuiTabs css-hash"
                >
                  <div
                    class="MuiTabs MuiTabs css-hash"
                    style="overflow: hidden; margin-bottom: 0px;"
                  >
                    <div
                      class="MuiTabs css-hash"
                      role="tablist"
                    >
                      <button
                        aria-selected="true"
                        class="Mui-selected MuiButtonBase MuiTab MuiTab css-hash"
                        role="tab"
                        tabindex="0"
                        type="button"
                      >
                        <p
                          class="MuiTypography MuiTypography css-hash"
                        >
                          All Clusters
                        </p>
                        <span
                          class="MuiTouchRipple css-hash"
                        />
                      </button>
                      <button
                        aria-selected="false"
                        class="MuiButtonBase MuiTab MuiTab css-hash"
                        role="tab"
                        tabindex="-1"
                        type="button"
                      >
                        <p
                          class="MuiTypography MuiTypography css-hash"
                        >
                          Projects
                        </p>
                        <span
                          class="MuiTouchRipple css-hash"
                        />
                      </button>
                    </div>
                    <span
                      class="MuiTabs css-hash"
                      style="left: 0px; width: 0px;"
                    />
                  </div>
                </div>
              </div>
              <div
                class="MuiBox css-hash"
              >
                <span
                  aria-label="Loading..."
                  class="MuiCircularProgress MuiCircularProgress MuiCircularProgress css-hash"
                  role="progressbar"
                  style="width: 40px; height: 40px;"
                  title="Loading..."
                >
                  <svg
                    class="MuiCircularProgress-svg css-1idz92c-MuiCircularProgress-svg"
                    viewBox="22 22 44 44"
                  >
                    <circle
                      class="MuiCircularProgress-circle MuiCircularProgress-circleIndeterminate css-176wh8e-MuiCircularProgress-circle"
                      cx="44"
                      cy="44"
                      fill="none"
                      r="20.2"
                      stroke-width="3.6"
                    />
                  </svg>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>