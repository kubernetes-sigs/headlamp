<body>
  <div>
    <div
      class="MuiGrid MuiGrid MuiGrid css-hash"
    >
      <div
        class="MuiGrid MuiGrid MuiGrid css-hash"
      >
        <img
          alt=""
          class="css-hash"
          src="/src/assets/headlamp-broken.svg"
        />
        <h1
          class="MuiTypography MuiTypography css-hash"
        >
          Uh-oh! Something went wrong.
        </h1>
        <h2
          class="MuiTypography MuiTypography css-hash"
        >
          Error loading My Test Route
        </h2>
      </div>
      <div
        class="MuiGrid MuiGrid MuiGrid css-hash"
      >
        <div
          class="MuiBox css-hash"
        >
          <div
            class="MuiAccordion MuiAccordion MuiAccordion MuiPaper MuiPaper MuiPaper css-hash"
          >
            <div
              aria-expanded="false"
              class="MuiAccordionSummary MuiAccordionSummary MuiButtonBase css-hash"
              role="button"
              tabindex="0"
            >
              <div
                class="MuiAccordionSummary MuiAccordionSummary css-hash"
              >
                <p
                  class="MuiTypography MuiTypography css-hash"
                >
                  Error Details
                </p>
              </div>
              <div
                class="MuiAccordionSummary css-hash"
              />
            </div>
            <div
              class="MuiCollapse MuiCollapse MuiCollapse css-hash"
              style="min-height: 0px;"
            >
              <div
                class="MuiCollapse MuiCollapse css-hash"
              >
                <div
                  class="MuiCollapse MuiCollapse css-hash"
                >
                  <div
                    class="MuiAccordion"
                    role="region"
                  >
                    <div
                      class="MuiAccordionDetails css-hash"
                    >
                      <div
                        class="MuiBox css-hash"
                      >
                        <button
                          class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
                          tabindex="0"
                          type="button"
                        >
                          Copy
                          <span
                            class="MuiTouchRipple css-hash"
                          />
                        </button>
                        <button
                          class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
                          tabindex="0"
                          type="button"
                        >
                          Open Issue on GitHub
                          <span
                            class="MuiTouchRipple css-hash"
                          />
                        </button>
                      </div>
                      <pre
                        class="MuiTypography MuiTypography css-hash"
                      >
                        Here is the stack trace
                      </pre>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>