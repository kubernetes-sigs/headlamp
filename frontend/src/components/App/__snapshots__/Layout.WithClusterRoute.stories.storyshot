<body>
  <div>
    <a
      class="MuiLink MuiLink MuiTypography MuiTypography css-hash"
      href="#main"
    >
      Skip to main content
    </a>
    <div
      class="MuiBox css-hash"
    >
      <div
        class="MuiBox css-hash"
      >
        <nav
          aria-label="Appbar Tools"
          class="MuiAppBar MuiAppBar MuiAppBar MuiPaper MuiPaper css-hash"
        >
          <div
            class="MuiToolbar MuiToolbar MuiToolbar css-hash"
          >
            <div
              class="MuiBox css-hash"
            />
            <div
              class="MuiBox css-hash"
            >
              <div
                class="MuiBox css-hash"
              >
                <div
                  class="MuiFormControl MuiFormControl MuiTextField css-hash"
                >
                  <div
                    class="MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                  >
                    <div
                      class="MuiInputAdornment MuiInputAdornment MuiInputAdornment MuiInputAdornment css-hash"
                    >
                      <span
                        class="notranslate"
                      >
                        ​
                      </span>
                    </div>
                    <input
                      aria-invalid="false"
                      class="MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                      id=":mock-test-id:"
                      placeholder="Search"
                      type="text"
                      value=""
                    />
                    <div
                      class="MuiBox css-hash"
                    >
                      Press
                      <kbd
                        class="MuiBox css-hash"
                      >
                        /
                      </kbd>
                      to search
                    </div>
                    <fieldset
                      aria-hidden="true"
                      class="MuiOutlinedInput css-hash"
                    >
                      <legend
                        class="css-hash"
                      >
                        <span
                          class="notranslate"
                        >
                          ​
                        </span>
                      </legend>
                    </fieldset>
                  </div>
                </div>
              </div>
            </div>
            <div
              class="MuiBox css-hash"
            />
          </div>
        </nav>
        <div
          class="MuiBox css-hash"
        >
          <main
            class="css-hash"
            id="main"
          >
            <div
              class="MuiBox css-hash"
            >
              <div
                class="css-hash"
              />
              <div
                class="MuiContainer MuiContainer css-hash"
              />
            </div>
          </main>
          <div
            class="MuiBox css-hash"
          />
        </div>
      </div>
    </div>
  </div>
</body>