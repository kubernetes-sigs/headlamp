<body>
  <div>
    <div
      class="MuiGrid MuiGrid MuiGrid css-hash"
    >
      <div
        class="MuiGrid MuiGrid MuiGrid css-hash"
      >
        <div
          class="MuiBox css-hash"
        >
          <button
            class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
            tabindex="0"
            type="button"
          >
            <span
              class="MuiButton MuiButton MuiButton css-hash"
            />
            <p
              class="MuiTypography MuiTypography css-hash"
              style="padding-top: 3px;"
            >
              Back
            </p>
            <span
              class="MuiTouchRipple css-hash"
            />
          </button>
          <div
            class="MuiBox css-hash"
          >
            <div
              class="MuiGrid MuiGrid MuiGrid css-hash"
            >
              <div
                class="MuiGrid MuiGrid css-hash"
              >
                <div
                  class="MuiBox css-hash"
                >
                  <h1
                    class="MuiTypography MuiTypography MuiTypography css-hash"
                  >
                    MyCustomResource: mycustomresource
                  </h1>
                  <div
                    class="MuiBox css-hash"
                  >
                    <button
                      aria-label="Copy to clipboard"
                      class="MuiButtonBase MuiIconButton MuiIconButton css-hash"
                      data-mui-internal-clone-element="true"
                      tabindex="0"
                      type="button"
                    >
                      <span
                        class="MuiTouchRipple css-hash"
                      />
                    </button>
                  </div>
                </div>
              </div>
              <div
                class="MuiGrid MuiGrid css-hash"
              >
                <div
                  class="MuiGrid MuiGrid MuiGrid css-hash"
                >
                  <div
                    class="MuiGrid MuiGrid css-hash"
                  />
                  <div
                    class="MuiGrid MuiGrid css-hash"
                  />
                  <div
                    class="MuiGrid MuiGrid css-hash"
                  >
                    <button
                      aria-label="Edit"
                      class="MuiButtonBase MuiIconButton MuiIconButton css-hash"
                      data-mui-internal-clone-element="true"
                      tabindex="0"
                      type="button"
                    >
                      <span
                        class="MuiTouchRipple css-hash"
                      />
                    </button>
                  </div>
                  <div
                    class="MuiGrid MuiGrid css-hash"
                  >
                    <button
                      aria-label="Delete"
                      class="MuiButtonBase MuiIconButton MuiIconButton css-hash"
                      data-mui-internal-clone-element="true"
                      tabindex="0"
                      type="button"
                    >
                      <span
                        class="MuiTouchRipple css-hash"
                      />
                    </button>
                    <div />
                  </div>
                </div>
              </div>
            </div>
            <div
              aria-busy="false"
              aria-live="polite"
              class="MuiBox css-hash"
            >
              <div
                class="MuiBox css-hash"
              >
                <dl
                  class="MuiGrid MuiGrid css-hash"
                >
                  <dt
                    class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
                  >
                    Name
                  </dt>
                  <dd
                    class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
                  >
                    <span
                      class="MuiTypography MuiTypography css-hash"
                    >
                      mycustomresource
                    </span>
                  </dd>
                  <dt
                    class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
                  >
                    Namespace
                  </dt>
                  <dd
                    class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
                  >
                    <a
                      class="MuiLink MuiLink MuiTypography MuiTypography css-hash"
                      href="/"
                    >
                      mynamespace
                    </a>
                  </dd>
                  <dt
                    class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
                  >
                    Creation
                  </dt>
                  <dd
                    class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
                  >
                    <span
                      class="MuiTypography MuiTypography css-hash"
                    >
                      2021-12-15T14:57:13.000Z
                    </span>
                  </dd>
                  <dt
                    class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
                  >
                    Definition
                  </dt>
                  <dd
                    class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
                  >
                    <a
                      class="MuiLink MuiLink MuiTypography MuiTypography css-hash"
                      href="/"
                    >
                      mydefinition.phonyresources.io
                    </a>
                  </dd>
                  <dt
                    class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
                  >
                    Test Col
                  </dt>
                  <dd
                    class="MuiGrid MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
                  >
                    <p
                      aria-label="My description"
                      class="MuiTypography MuiTypography css-hash"
                      data-mui-internal-clone-element="true"
                    >
                      mycustomresource
                    </p>
                  </dd>
                </dl>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div
        class="MuiGrid MuiGrid MuiGrid css-hash"
      >
        <div
          class="MuiBox css-hash"
        />
      </div>
      <div
        class="MuiGrid MuiGrid MuiGrid css-hash"
      >
        <div
          class="MuiBox css-hash"
        >
          <div
            class="MuiBox css-hash"
          >
            <div
              class="MuiGrid MuiGrid MuiGrid css-hash"
            >
              <div
                class="MuiGrid MuiGrid css-hash"
              >
                <div
                  class="MuiBox css-hash"
                >
                  <h2
                    class="MuiTypography MuiTypography MuiTypography css-hash"
                  >
                    Events
                  </h2>
                  <div
                    class="MuiBox css-hash"
                  >
                    <button
                      aria-label="Events lifetime information"
                      class="MuiButtonBase MuiIconButton MuiIconButton css-hash"
                      data-mui-internal-clone-element="true"
                      tabindex="0"
                      type="button"
                    >
                      <span
                        class="MuiTouchRipple css-hash"
                      />
                    </button>
                  </div>
                </div>
              </div>
            </div>
            <div
              class="MuiBox css-hash"
            >
              <div
                aria-atomic="true"
                aria-live="polite"
                class="MuiBox css-hash"
                role="status"
              >
                No data to be shown.
              </div>
              <div
                class="MuiPaper MuiPaper MuiPaper css-hash"
              >
                <div
                  class="MuiBox css-hash"
                >
                  <p
                    class="MuiTypography MuiTypography MuiTypography css-hash"
                  >
                    No data to be shown.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>