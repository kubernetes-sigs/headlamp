<body>
  <div>
    <div
      style="display: flex; flex-direction: column; height: 100vh;"
    >
      <div
        style="padding: 16px; background: rgb(245, 245, 245); border-bottom: 1px solid rgb(221, 221, 221); display: flex; gap: 16px; align-items: center; flex-wrap: wrap;"
      >
        <h3
          style="margin: 0px;"
        >
          Performance Test: 2000 Pods
        </h3>
        <div
          style="display: flex; gap: 8px; align-items: center;"
        >
          <button
            style="padding: 8px 16px; cursor: pointer;"
          >
            Trigger Update (#
            0
            )
          </button>
          <label
            style="display: flex; align-items: center; gap: 4px;"
          >
            <input
              type="checkbox"
            />
            Auto-update
          </label>
          <label
            style="display: flex; align-items: center; gap: 4px;"
          >
            Interval:
            <select>
              <option
                value="1000"
              >
                1s
              </option>
              <option
                value="2000"
              >
                2s
              </option>
              <option
                value="5000"
              >
                5s
              </option>
              <option
                value="10000"
              >
                10s
              </option>
            </select>
          </label>
          <label
            style="display: flex; align-items: center; gap: 4px;"
          >
            Change %:
            <select
              style="background-color: rgb(232, 245, 233); padding: 4px;"
              title="Small change - uses incremental optimization (85-92% faster)"
            >
              <option
                value="1"
              >
                1% (20 pods) - Incremental
              </option>
              <option
                value="2"
              >
                2% (40 pods) - Incremental
              </option>
              <option
                value="5"
              >
                5% (100 pods) - Incremental
              </option>
              <option
                value="10"
              >
                10% (200 pods) - Incremental
              </option>
              <option
                value="20"
              >
                20% (400 pods) - Threshold
              </option>
              <option
                value="25"
              >
                25% (500 pods) - Full Processing
              </option>
              <option
                value="50"
              >
                50% (1000 pods) - Full Processing
              </option>
              <option
                value="100"
              >
                100% (2000 pods) - Full Processing
              </option>
            </select>
          </label>
        </div>
        <div
          style="font-size: 14px; color: rgb(102, 102, 102);"
        >
          Nodes: 
          2000
           | Edges: 
          2000
           | Update #
          0
           (
          1
          % changed = 
          20
           
          pods)
        </div>
        <div
          style="font-size: 12px; color: rgb(46, 125, 50); font-style: italic; max-width: 900px; padding: 8px; background-color: rgb(232, 245, 233); border-radius: 4px;"
        >
          💡 
          <strong>
            Change 
            1
            %
          </strong>
          :
           
          <strong>
            Incremental Optimization
          </strong>
           - Typical time ~35-70ms (85-92% faster than 250ms full processing). Toggle "Incremental Updates" in GraphView to compare performance.
        </div>
      </div>
      <div
        style="flex: 1 1 0%;"
      >
        <div
          class="MuiBox css-hash"
        >
          <div
            class="MuiBox css-hash"
          >
            <div
              class="MuiBox css-hash"
            >
              <div
                class="MuiAutocomplete MuiAutocomplete css-hash"
              >
                <div
                  class="MuiBox css-hash"
                >
                  <div
                    class="MuiFormControl MuiFormControl MuiTextField css-hash"
                    style="margin-top: 0px;"
                  >
                    <label
                      class="MuiFormLabel MuiFormLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel css-hash"
                      data-shrink="true"
                      for="namespaces-filter"
                      id="namespaces-filter-label"
                    >
                      Namespaces
                    </label>
                    <div
                      class="MuiAutocomplete MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                    >
                      <input
                        aria-autocomplete="both"
                        aria-expanded="false"
                        aria-invalid="false"
                        autocapitalize="none"
                        autocomplete="off"
                        class="MuiAutocomplete MuiAutocomplete MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                        id="namespaces-filter"
                        placeholder="Filter"
                        role="combobox"
                        spellcheck="false"
                        type="text"
                        value=""
                      />
                      <div
                        class="MuiAutocomplete css-hash"
                      >
                        <button
                          aria-label="Open"
                          class="MuiAutocomplete MuiButtonBase MuiIconButton MuiIconButton css-hash"
                          tabindex="-1"
                          title="Open"
                          type="button"
                        >
                          <svg
                            aria-hidden="true"
                            class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium css-i4bv87-MuiSvgIcon-root"
                            data-testid="ArrowDropDownIcon"
                            focusable="false"
                            viewBox="0 0 24 24"
                          >
                            <path
                              d="M7 10l5 5 5-5z"
                            />
                          </svg>
                          <span
                            class="MuiTouchRipple css-hash"
                          />
                        </button>
                      </div>
                      <fieldset
                        aria-hidden="true"
                        class="MuiOutlinedInput css-hash"
                      >
                        <legend
                          class="css-hash"
                        >
                          <span>
                            Namespaces
                          </span>
                        </legend>
                      </fieldset>
                    </div>
                  </div>
                </div>
              </div>
              <div
                class="MuiAutocomplete MuiAutocomplete css-hash"
              >
                <div
                  class="MuiFormControl MuiFormControl MuiTextField css-hash"
                >
                  <div
                    class="MuiAutocomplete MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                  >
                    <input
                      aria-autocomplete="list"
                      aria-expanded="false"
                      aria-invalid="false"
                      autocapitalize="none"
                      autocomplete="off"
                      class="MuiAutocomplete MuiAutocomplete MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                      id=":mock-test-id:"
                      placeholder="Resource Types"
                      role="combobox"
                      spellcheck="false"
                      type="text"
                      value=""
                    />
                    <div
                      class="MuiAutocomplete css-hash"
                    >
                      <button
                        aria-label="Open"
                        class="MuiAutocomplete MuiButtonBase MuiIconButton MuiIconButton css-hash"
                        tabindex="-1"
                        title="Open"
                        type="button"
                      >
                        <svg
                          aria-hidden="true"
                          class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium css-i4bv87-MuiSvgIcon-root"
                          data-testid="ArrowDropDownIcon"
                          focusable="false"
                          viewBox="0 0 24 24"
                        >
                          <path
                            d="M7 10l5 5 5-5z"
                          />
                        </svg>
                        <span
                          class="MuiTouchRipple css-hash"
                        />
                      </button>
                    </div>
                    <fieldset
                      aria-hidden="true"
                      class="MuiOutlinedInput css-hash"
                    >
                      <legend
                        class="css-hash"
                      >
                        <span
                          class="notranslate"
                        >
                          ​
                        </span>
                      </legend>
                    </fieldset>
                  </div>
                </div>
              </div>
              <div
                class="MuiFormControl MuiTextField css-hash"
              >
                <div
                  class="MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                >
                  <input
                    aria-invalid="false"
                    class="MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                    id=":mock-test-id:"
                    placeholder="Labels (e.g. app=nginx)"
                    type="text"
                    value=""
                  />
                  <fieldset
                    aria-hidden="true"
                    class="MuiOutlinedInput css-hash"
                  >
                    <legend
                      class="css-hash"
                    >
                      <span
                        class="notranslate"
                      >
                        ​
                      </span>
                    </legend>
                  </fieldset>
                </div>
              </div>
              <div
                class="MuiButtonBase MuiChip MuiChip MuiChip MuiChip MuiChip MuiChip MuiChip css-hash"
                role="button"
                tabindex="0"
              >
                <span
                  class="MuiChip MuiChip css-hash"
                >
                  <div
                    class="MuiStack css-hash"
                  >
                     
                    Pods (2000)
                     
                  </div>
                </span>
                <span
                  class="MuiTouchRipple css-hash"
                />
              </div>
              <div
                class="MuiBox css-hash"
              >
                Group By
              </div>
              <div
                class="MuiBox css-hash"
              >
                <div
                  class="MuiButtonBase MuiChip MuiChip MuiChip MuiChip MuiChip MuiChip MuiChip css-hash"
                  role="button"
                  tabindex="0"
                >
                  <span
                    class="MuiChip MuiChip css-hash"
                  >
                    Namespace
                  </span>
                  <span
                    class="MuiTouchRipple css-hash"
                  />
                </div>
                <div
                  class="MuiButtonBase MuiChip MuiChip MuiChip MuiChip MuiChip MuiChip MuiChip css-hash"
                  role="button"
                  tabindex="0"
                >
                  <span
                    class="MuiChip MuiChip css-hash"
                  >
                    Instance
                  </span>
                  <span
                    class="MuiTouchRipple css-hash"
                  />
                </div>
                <div
                  class="MuiButtonBase MuiChip MuiChip MuiChip MuiChip MuiChip MuiChip MuiChip css-hash"
                  role="button"
                  tabindex="0"
                >
                  <span
                    class="MuiChip MuiChip css-hash"
                  >
                    Node
                  </span>
                  <span
                    class="MuiTouchRipple css-hash"
                  />
                </div>
              </div>
              <div
                class="MuiButtonBase MuiChip MuiChip MuiChip MuiChip MuiChip MuiChip MuiChip css-hash"
                role="button"
                tabindex="0"
              >
                <span
                  class="MuiChip MuiChip css-hash"
                >
                  Status: Error or Warning
                </span>
                <span
                  class="MuiTouchRipple css-hash"
                />
              </div>
              <div
                class="MuiButtonBase MuiChip MuiChip MuiChip MuiChip MuiChip MuiChip MuiChip css-hash"
                role="button"
                tabindex="0"
              >
                <span
                  class="MuiChip MuiChip css-hash"
                >
                  Simplify (500 most important)
                </span>
                <span
                  class="MuiTouchRipple css-hash"
                />
              </div>
              <div
                class="MuiChip MuiChip MuiChip MuiChip MuiChip css-hash"
              >
                <span
                  class="MuiChip MuiChip css-hash"
                >
                  Showing 500 of 2000 nodes
                </span>
              </div>
            </div>
            <div
              style="flex-grow: 1;"
            >
              <div
                class="light react-flow"
                data-testid="rf__wrapper"
                role="application"
                style="width: 100%; height: 100%; overflow: hidden; position: relative; z-index: 0;"
              >
                <div
                  class="react-flow__renderer"
                  style="position: absolute; width: 100%; height: 100%; top: 0px; left: 0px; -webkit-tap-highlight-color: rgba(0, 0, 0, 0);"
                >
                  <div
                    class="draggable react-flow__pane"
                    style="position: absolute; width: 100%; height: 100%; top: 0px; left: 0px;"
                  >
                    <div
                      class="react-flow__container react-flow__viewport xyflow__viewport"
                      style="transform: translate(0px,0px) scale(1);"
                    >
                      <div
                        class="react-flow__edges"
                      />
                      <div
                        class="react-flow__edgelabel-renderer"
                      />
                      <div
                        class="react-flow__nodes"
                        style="position: absolute; width: 100%; height: 100%; top: 0px; left: 0px;"
                      />
                      <div
                        class="react-flow__viewport-portal"
                      />
                    </div>
                  </div>
                </div>
                <svg
                  class="react-flow__background"
                  data-testid="rf__background"
                  style="position: absolute; width: 100%; height: 100%; top: 0px; left: 0px; --xy-background-pattern-color-props: rgba(0, 0, 0, 0.12);"
                >
                  <pattern
                    height="20"
                    id="pattern-1"
                    patternTransform="translate(-11,-11)"
                    patternUnits="userSpaceOnUse"
                    width="20"
                    x="0"
                    y="0"
                  >
                    <circle
                      class="react-flow__background-pattern dots"
                      cx="1"
                      cy="1"
                      r="1"
                    />
                  </pattern>
                  <rect
                    fill="url(#pattern-1)"
                    height="100%"
                    width="100%"
                    x="0"
                    y="0"
                  />
                </svg>
                <div
                  aria-label="Control Panel"
                  class="bottom left react-flow__controls react-flow__panel vertical"
                  data-testid="rf__controls"
                >
                  <div
                    class="MuiBox css-hash"
                  >
                    <div
                      aria-label="Graph controls"
                      class="MuiButtonGroup MuiButtonGroup MuiButtonGroup css-hash"
                      role="group"
                    >
                      <button
                        class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase MuiButtonGroup MuiButtonGroup MuiButtonGroup MuiButtonGroup MuiButtonGroup MuiButtonGroup MuiButtonGroup MuiButtonGroup MuiButtonGroup MuiButtonGroup MuiButtonGroup css-hash"
                        tabindex="0"
                        title="Zoom in"
                        type="button"
                      >
                        <span
                          class="MuiTouchRipple css-hash"
                        />
                      </button>
                      <button
                        class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase MuiButtonGroup MuiButtonGroup MuiButtonGroup MuiButtonGroup MuiButtonGroup MuiButtonGroup MuiButtonGroup MuiButtonGroup MuiButtonGroup MuiButtonGroup MuiButtonGroup css-hash"
                        tabindex="0"
                        title="Zoom out"
                        type="button"
                      >
                        <span
                          class="MuiTouchRipple css-hash"
                        />
                      </button>
                    </div>
                    <button
                      class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
                      tabindex="0"
                      title="Fit to screen"
                      type="button"
                    >
                      <span
                        class="MuiTouchRipple css-hash"
                      />
                    </button>
                    <button
                      class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
                      tabindex="0"
                      title="Zoom to 100%"
                      type="button"
                    >
                      100%
                      <span
                        class="MuiTouchRipple css-hash"
                      />
                    </button>
                  </div>
                </div>
                <p
                  class="MuiTypography MuiTypography css-hash"
                >
                  No data to be shown. Try to change filters or select a different namespace.
                </p>
                <div
                  class="left react-flow__panel top"
                />
                <div
                  class="bottom react-flow__attribution react-flow__panel right"
                  data-message="Please only hide this attribution when you are subscribed to React Flow Pro: https://pro.reactflow.dev"
                >
                  <a
                    aria-label="React Flow attribution"
                    href="https://reactflow.dev"
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    React Flow
                  </a>
                </div>
                <div
                  id="react-flow__node-desc-1"
                  style="display: none;"
                >
                  Press enter or space to select a node. You can then use the arrow keys to move the node around. Press delete to remove it and escape to cancel.
                </div>
                <div
                  id="react-flow__edge-desc-1"
                  style="display: none;"
                >
                  Press enter or space to select an edge. You can then press delete to remove it or escape to cancel.
                </div>
                <div
                  aria-atomic="true"
                  aria-live="assertive"
                  id="react-flow__aria-live-1"
                  style="position: absolute; width: 1px; height: 1px; margin: -1px; border: 0px; padding: 0px; overflow: hidden; clip: rect(0px, 0px, 0px, 0px); clip-path: inset(100%);"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>