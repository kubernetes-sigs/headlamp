<body>
  <div>
    <nav
      aria-label="Navigation"
      class="MuiBox css-hash"
    >
      <div
        class="MuiDrawer MuiDrawer css-hash"
      >
        <div
          class="MuiDrawer MuiDrawer MuiDrawer MuiPaper MuiPaper css-hash"
        >
          <div
            class="MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
          >
            <div
              class="MuiGrid MuiGrid css-hash"
            >
              <ul
                class="MuiList MuiList css-hash"
              >
                <li
                  class="css-hash"
                >
                  <a
                    class="MuiButtonBase MuiListItemButton MuiListItemButton MuiListItemButton MuiListItemButton css-hash"
                    href="/"
                    role="button"
                    tabindex="0"
                  >
                    <div
                      class="MuiListItemIcon css-hash"
                    />
                    <div
                      class="MuiListItemText css-hash"
                    >
                      <span
                        class="MuiListItemText MuiTypography MuiTypography css-hash"
                      >
                        Home
                      </span>
                    </div>
                    <span
                      class="MuiTouchRipple css-hash"
                    />
                  </a>
                </li>
                <li
                  class="css-hash"
                >
                  <a
                    class="MuiButtonBase MuiListItemButton MuiListItemButton MuiListItemButton MuiListItemButton css-hash"
                    href="/notifications"
                    role="button"
                    tabindex="0"
                  >
                    <div
                      class="MuiListItemIcon css-hash"
                    />
                    <div
                      class="MuiListItemText css-hash"
                    >
                      <span
                        class="MuiListItemText MuiTypography MuiTypography css-hash"
                      >
                        Notifications
                      </span>
                    </div>
                    <span
                      class="MuiTouchRipple css-hash"
                    />
                  </a>
                </li>
                <li
                  class="css-hash"
                >
                  <a
                    class="Mui-selected Mui-selected MuiButtonBase MuiListItemButton MuiListItemButton MuiListItemButton MuiListItemButton css-hash"
                    href="/settings/general"
                    role="button"
                    tabindex="0"
                  >
                    <div
                      class="MuiListItemIcon css-hash"
                    />
                    <div
                      class="MuiListItemText css-hash"
                    >
                      <span
                        class="MuiListItemText MuiTypography MuiTypography css-hash"
                      >
                        Settings
                      </span>
                    </div>
                    <span
                      class="MuiTouchRipple css-hash"
                    />
                  </a>
                </li>
                <li
                  class="MuiCollapse MuiCollapse MuiCollapse css-hash"
                  style="min-height: 0px;"
                >
                  <div
                    class="MuiCollapse MuiCollapse css-hash"
                  >
                    <div
                      class="MuiCollapse MuiCollapse css-hash"
                    >
                      <ul
                        class="MuiList css-hash"
                      >
                        <li
                          class="css-hash"
                        >
                          <a
                            class="MuiButtonBase MuiListItemButton MuiListItemButton MuiListItemButton MuiListItemButton css-hash"
                            href="/settings/general"
                            role="button"
                            tabindex="0"
                          >
                            <div
                              class="MuiListItemText css-hash"
                            >
                              <span
                                class="MuiListItemText MuiTypography MuiTypography css-hash"
                              >
                                General
                              </span>
                            </div>
                            <span
                              class="MuiTouchRipple css-hash"
                            />
                          </a>
                        </li>
                        <li
                          class="css-hash"
                        >
                          <a
                            class="MuiButtonBase MuiListItemButton MuiListItemButton MuiListItemButton MuiListItemButton css-hash"
                            href="/settings/plugins"
                            role="button"
                            tabindex="0"
                          >
                            <div
                              class="MuiListItemText css-hash"
                            >
                              <span
                                class="MuiListItemText MuiTypography MuiTypography css-hash"
                              >
                                Plugins
                              </span>
                            </div>
                            <span
                              class="MuiTouchRipple css-hash"
                            />
                          </a>
                        </li>
                        <li
                          class="css-hash"
                        >
                          <a
                            class="MuiButtonBase MuiListItemButton MuiListItemButton MuiListItemButton MuiListItemButton css-hash"
                            href="/settings/cluster"
                            role="button"
                            tabindex="0"
                          >
                            <div
                              class="MuiListItemText css-hash"
                            >
                              <span
                                class="MuiListItemText MuiTypography MuiTypography css-hash"
                              >
                                Cluster
                              </span>
                            </div>
                            <span
                              class="MuiTouchRipple css-hash"
                            />
                          </a>
                        </li>
                      </ul>
                    </div>
                  </div>
                </li>
              </ul>
            </div>
            <div
              class="MuiGrid MuiGrid css-hash"
            >
              <div
                class="MuiBox css-hash"
              >
                <div
                  class="MuiBox css-hash"
                >
                  <div
                    class="MuiBox css-hash"
                  />
                  <div
                    class="MuiBox css-hash"
                  >
                    <div
                      class="MuiBox css-hash"
                    >
                      <button
                        aria-label="Shrink sidebar"
                        class="MuiButtonBase MuiIconButton MuiIconButton css-hash"
                        data-mui-internal-clone-element="true"
                        tabindex="0"
                        type="button"
                      >
                        <span
                          class="MuiTouchRipple css-hash"
                        />
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>
  </div>
</body>