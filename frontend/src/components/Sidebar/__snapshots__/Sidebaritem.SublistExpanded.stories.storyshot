<body>
  <div>
    <div
      class="MuiGrid MuiGrid css-hash"
      style="background-color: rgba(0, 0, 0, 0.87);"
    >
      <ul
        class="MuiList MuiList css-hash"
      >
        <li
          class="css-hash"
        >
          <a
            class="Mui-selected Mui-selected MuiButtonBase MuiListItemButton MuiListItemButton MuiListItemButton MuiListItemButton css-hash"
            href="/"
            role="button"
            tabindex="0"
          >
            <div
              class="MuiListItemIcon css-hash"
            />
            <div
              class="MuiListItemText css-hash"
            >
              <span
                class="MuiListItemText MuiTypography MuiTypography css-hash"
              >
                Cluster
              </span>
            </div>
            <span
              class="MuiTouchRipple css-hash"
            />
          </a>
        </li>
        <li
          class="MuiCollapse MuiCollapse MuiCollapse css-hash"
          style="min-height: 0px;"
        >
          <div
            class="MuiCollapse MuiCollapse css-hash"
          >
            <div
              class="MuiCollapse MuiCollapse css-hash"
            >
              <ul
                class="MuiList css-hash"
              >
                <li
                  class="css-hash"
                >
                  <a
                    class="MuiButtonBase MuiListItemButton MuiListItemButton MuiListItemButton MuiListItemButton css-hash"
                    href="/"
                    role="button"
                    tabindex="0"
                  >
                    <div
                      class="MuiListItemText css-hash"
                    >
                      <span
                        class="MuiListItemText MuiTypography MuiTypography css-hash"
                      >
                        Namespaces
                      </span>
                    </div>
                    <span
                      class="MuiTouchRipple css-hash"
                    />
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </li>
      </ul>
    </div>
  </div>
</body>