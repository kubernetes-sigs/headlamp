<body>
  <div
    aria-hidden="true"
  >
    <button>
      Open Popup
    </button>
  </div>
  <div
    class="MuiDialog MuiModal css-hash"
    role="presentation"
  >
    <div
      aria-hidden="true"
      class="MuiBackdrop MuiModal css-hash"
      style="opacity: 1; transition: opacity 225ms cubic-bezier(0.4, 0, 0.2, 1) 0ms;"
    />
    <div
      data-testid="sentinelStart"
      tabindex="0"
    />
    <div
      class="MuiDialog MuiDialog css-hash"
      role="presentation"
      style="opacity: 1; transition: opacity 225ms cubic-bezier(0.4, 0, 0.2, 1) 0ms;"
      tabindex="-1"
    >
      <div
        aria-labelledby=":mock-test-id:"
        class="MuiDialog MuiDialog MuiDialog MuiPaper MuiPaper MuiPaper css-hash"
        role="dialog"
      >
        <h1
          class="MuiDialogTitle MuiTypography MuiTypography css-hash"
          id=":mock-test-id:"
        >
          Create a Project
        </h1>
        <div
          class="MuiDialogContent css-hash"
        >
          <p
            class="MuiTypography MuiTypography css-hash"
          >
            Project is a collection of Kubernetes resources. You can use projects to organize your resources, for example, by environment, team, or application.
          </p>
          <div
            class="MuiBox css-hash"
          >
            <button
              class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
              tabindex="0"
              type="button"
            >
              <div
                class="MuiBox css-hash"
              />
              <div
                class="MuiBox css-hash"
              >
                <span
                  class="MuiTypography MuiTypography css-hash"
                >
                  New Project
                </span>
                <p
                  class="MuiTypography MuiTypography css-hash"
                >
                  Create a new project
                </p>
              </div>
              <span
                class="MuiTouchRipple css-hash"
              />
            </button>
            <button
              class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
              tabindex="0"
              type="button"
            >
              <div
                class="MuiBox css-hash"
              />
              <div
                class="MuiBox css-hash"
              >
                <span
                  class="MuiTypography MuiTypography css-hash"
                >
                  New Project from YAML
                </span>
                <p
                  class="MuiTypography MuiTypography css-hash"
                >
                  Deploy a new application from YAML
                </p>
              </div>
              <span
                class="MuiTouchRipple css-hash"
              />
            </button>
          </div>
        </div>
        <div
          class="MuiDialogActions MuiDialogActions css-hash"
        >
          <button
            class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
            tabindex="0"
            type="button"
          >
            Cancel
            <span
              class="MuiTouchRipple css-hash"
            />
          </button>
        </div>
      </div>
    </div>
    <div
      data-testid="sentinelEnd"
      tabindex="0"
    />
  </div>
</body>