<body>
  <div>
    <div
      style="height: 800px;"
    >
      <div
        class="MuiDialogContent css-hash"
      >
        <form>
          <h1
            class="MuiTypography MuiTypography css-hash"
          >
            Create new Project from YAML
          </h1>
          <div
            class="MuiGrid MuiGrid MuiGrid css-hash"
          >
            <div
              class="MuiGrid MuiGrid MuiGrid css-hash"
            >
              <p
                class="MuiTypography MuiTypography css-hash"
              >
                Project name
              </p>
              <p
                class="MuiTypography MuiTypography css-hash"
              >
                Give your project a descriptive name
              </p>
            </div>
            <div
              class="MuiGrid MuiGrid MuiGrid css-hash"
            >
              <div
                class="MuiFormControl MuiTextField css-hash"
              >
                <label
                  class="Mui-required MuiFormLabel MuiFormLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel css-hash"
                  data-shrink="false"
                  for=":mock-test-id:"
                  id=":mock-test-id:"
                >
                  Project Name
                  <span
                    aria-hidden="true"
                    class="MuiFormLabel MuiInputLabel css-hash"
                  >
                     
                    *
                  </span>
                </label>
                <div
                  class="MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                >
                  <input
                    aria-invalid="false"
                    class="MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                    id=":mock-test-id:"
                    placeholder="Enter a name"
                    required=""
                    type="text"
                    value=""
                  />
                  <fieldset
                    aria-hidden="true"
                    class="MuiOutlinedInput css-hash"
                  >
                    <legend
                      class="css-hash"
                    >
                      <span>
                        Project Name
                         
                        *
                      </span>
                    </legend>
                  </fieldset>
                </div>
              </div>
            </div>
            <div
              class="MuiGrid MuiGrid MuiGrid css-hash"
            >
              <p
                class="MuiTypography MuiTypography css-hash"
              >
                Cluster
              </p>
              <p
                class="MuiTypography MuiTypography css-hash"
              >
                Select cluster for this project
              </p>
            </div>
            <div
              class="MuiGrid MuiGrid MuiGrid css-hash"
            >
              <div
                class="MuiAutocomplete MuiAutocomplete css-hash"
              >
                <div
                  class="MuiFormControl MuiFormControl MuiTextField css-hash"
                >
                  <label
                    class="Mui-disabled Mui-required MuiFormLabel MuiFormLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel css-hash"
                    data-shrink="false"
                    for=":mock-test-id:"
                    id=":mock-test-id:"
                  >
                    Clusters
                    <span
                      aria-hidden="true"
                      class="MuiFormLabel MuiInputLabel css-hash"
                    >
                       
                      *
                    </span>
                  </label>
                  <div
                    class="Mui-disabled MuiAutocomplete MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                  >
                    <input
                      aria-autocomplete="list"
                      aria-expanded="false"
                      aria-invalid="false"
                      autocapitalize="none"
                      autocomplete="off"
                      class="Mui-disabled MuiAutocomplete MuiAutocomplete MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                      disabled=""
                      id=":mock-test-id:"
                      required=""
                      role="combobox"
                      spellcheck="false"
                      type="text"
                      value=""
                    />
                    <div
                      class="MuiAutocomplete css-hash"
                    >
                      <button
                        aria-label="Open"
                        class="Mui-disabled Mui-disabled MuiAutocomplete MuiButtonBase MuiIconButton MuiIconButton css-hash"
                        disabled=""
                        tabindex="-1"
                        title="Open"
                        type="button"
                      >
                        <svg
                          aria-hidden="true"
                          class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium css-i4bv87-MuiSvgIcon-root"
                          data-testid="ArrowDropDownIcon"
                          focusable="false"
                          viewBox="0 0 24 24"
                        >
                          <path
                            d="M7 10l5 5 5-5z"
                          />
                        </svg>
                      </button>
                    </div>
                    <fieldset
                      aria-hidden="true"
                      class="MuiOutlinedInput css-hash"
                    >
                      <legend
                        class="css-hash"
                      >
                        <span>
                          Clusters
                           
                          *
                        </span>
                      </legend>
                    </fieldset>
                  </div>
                </div>
              </div>
            </div>
            <div
              class="MuiGrid MuiGrid MuiGrid css-hash"
            >
              <p
                class="MuiTypography MuiTypography css-hash"
              >
                Load resources
              </p>
              <p
                class="MuiTypography MuiTypography css-hash"
              >
                Upload files or load from URL
              </p>
            </div>
            <div
              class="MuiGrid MuiGrid MuiGrid css-hash"
            >
              <div
                class="MuiBox css-hash"
              >
                <div
                  class="MuiBox css-hash"
                >
                  <div
                    class="MuiTabs css-hash"
                  >
                    <div
                      class="MuiTabs MuiTabs css-hash"
                      style="overflow: hidden; margin-bottom: 0px;"
                    >
                      <div
                        class="MuiTabs css-hash"
                        role="tablist"
                      >
                        <button
                          aria-selected="true"
                          class="Mui-selected MuiButtonBase MuiTab MuiTab css-hash"
                          role="tab"
                          tabindex="0"
                          type="button"
                        >
                          Upload Files
                          <span
                            class="MuiTouchRipple css-hash"
                          />
                        </button>
                        <button
                          aria-selected="false"
                          class="MuiButtonBase MuiTab MuiTab css-hash"
                          role="tab"
                          tabindex="-1"
                          type="button"
                        >
                          Load from URL
                          <span
                            class="MuiTouchRipple css-hash"
                          />
                        </button>
                      </div>
                      <span
                        class="MuiTabs css-hash"
                        style="left: 0px; width: 0px;"
                      />
                    </div>
                  </div>
                </div>
                <div
                  class="MuiBox css-hash"
                >
                  <div
                    class="MuiBox css-hash"
                    role="presentation"
                    tabindex="0"
                  >
                    <div
                      class="MuiFormControl css-hash"
                    >
                      <input
                        accept="application/x-yaml,.yaml,.yml,text/yaml,.yaml,.yml,text/plain,.yaml,.yml"
                        aria-label="Choose Files"
                        multiple=""
                        style="border: 0px; clip: rect(0px, 0px, 0px, 0px); clip-path: inset(50%); height: 1px; margin: 0px -1px -1px 0px; overflow: hidden; padding: 0px; position: absolute; width: 1px; white-space: nowrap;"
                        tabindex="-1"
                        type="file"
                      />
                      <button
                        aria-label="Drag & drop YAML files here or click to choose files"
                        class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
                        data-mui-internal-clone-element="true"
                        tabindex="0"
                        type="button"
                      >
                        <span
                          class="MuiButton MuiButton MuiButton css-hash"
                        />
                        Choose Files
                        <span
                          class="MuiTouchRipple css-hash"
                        />
                      </button>
                    </div>
                    <p
                      class="MuiTypography MuiTypography css-hash"
                    >
                      Supports .yaml and .yml files
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div
            class="MuiDialogActions MuiDialogActions css-hash"
          >
            <button
              class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
              tabindex="0"
              type="button"
            >
              Cancel
              <span
                class="MuiTouchRipple css-hash"
              />
            </button>
            <button
              class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
              tabindex="0"
              type="submit"
            >
              Create
              <span
                class="MuiTouchRipple css-hash"
              />
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</body>