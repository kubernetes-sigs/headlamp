<body>
  <div
    aria-hidden="true"
  />
  <div
    class="MuiDialog MuiModal css-hash"
    role="presentation"
  >
    <div
      aria-hidden="true"
      class="MuiBackdrop MuiModal css-hash"
      style="opacity: 1; transition: opacity 225ms cubic-bezier(0.4, 0, 0.2, 1) 0ms;"
    />
    <div
      data-testid="sentinelStart"
      tabindex="0"
    />
    <div
      class="MuiDialog MuiDialog css-hash"
      role="presentation"
      style="opacity: 1; transition: opacity 225ms cubic-bezier(0.4, 0, 0.2, 1) 0ms;"
      tabindex="-1"
    >
      <div
        aria-labelledby="authchooser-dialog-title"
        class="MuiDialog MuiDialog MuiDialog MuiPaper MuiPaper MuiPaper css-hash"
        role="dialog"
      >
        <h2
          class="MuiDialogTitle MuiTypography MuiTypography css-hash"
          id="authchooser-dialog-title"
          style="display: flex;"
        >
          <div
            class="MuiGrid MuiGrid css-hash"
          >
            <div
              class="MuiGrid MuiGrid css-hash"
            >
              <div>
                <div
                  class="MuiBox css-hash"
                />
                <span
                  class="MuiBox css-hash"
                >
                  Headlamp
                </span>
              </div>
            </div>
            <div
              class="MuiGrid MuiGrid css-hash"
            >
              <div
                class="MuiBox css-hash"
              >
                <button
                  aria-label="Show build information"
                  class="MuiButtonBase MuiIconButton MuiIconButton css-hash"
                  tabindex="0"
                  type="button"
                >
                  <span
                    class="MuiTouchRipple css-hash"
                  />
                </button>
              </div>
            </div>
          </div>
        </h2>
        <div
          class="MuiDialogContent MuiDialogContent css-hash"
        >
          <main
            class="MuiBox css-hash"
          >
            <h2
              class="MuiDialogTitle MuiTypography MuiTypography css-hash"
              id="authchooser-dialog-title"
              style="display: flex;"
            >
              <div
                class="MuiGrid MuiGrid css-hash"
              >
                <div
                  class="MuiGrid MuiGrid css-hash"
                >
                  <h1
                    class="MuiTypography MuiTypography css-hash"
                    id="authchooser-dialog-title"
                    style="font-size: 1.25rem; font-weight: 500; line-height: 1.6;"
                    tabindex="-1"
                  >
                    Authentication
                  </h1>
                </div>
              </div>
            </h2>
            <div
              class="MuiBox css-hash"
            >
              <div
                class="MuiBox css-hash"
              >
                <div
                  class="MuiBox css-hash"
                >
                  <p
                    class="MuiTypography MuiTypography MuiTypography css-hash"
                  >
                    Failed to get authentication information: Oh no! Some error happened?!?
                  </p>
                </div>
                <a
                  class="MuiLink MuiLink MuiTypography MuiTypography css-hash"
                  href="/settings/cluster?c=some-cluster"
                >
                  Cluster settings
                </a>
              </div>
              <button
                class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
                tabindex="0"
                type="button"
              >
                Try Again
                <span
                  class="MuiTouchRipple css-hash"
                />
              </button>
            </div>
          </main>
          <div
            class="MuiBox css-hash"
          >
            <div
              class="MuiBox css-hash"
              role="button"
              style="cursor: pointer;"
              tabindex="0"
            >
              <div
                class="MuiBox css-hash"
              />
              <div
                class="MuiBox css-hash"
                style="text-transform: uppercase;"
              >
                Back
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div
      data-testid="sentinelEnd"
      tabindex="0"
    />
  </div>
</body>