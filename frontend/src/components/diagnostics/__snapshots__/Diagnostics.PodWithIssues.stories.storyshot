<body>
  <div>
    <div
      class="MuiBox css-hash"
    >
      <div
        class="MuiGrid MuiGrid MuiGrid css-hash"
      >
        <div
          class="MuiGrid MuiGrid css-hash"
        >
          <div
            class="MuiBox css-hash"
          >
            <h2
              class="MuiTypography MuiTypography MuiTypography css-hash"
            >
              Diagnostics
            </h2>
            <div
              class="MuiBox css-hash"
            />
          </div>
        </div>
      </div>
      <div
        class="MuiBox css-hash"
      >
        <div
          class="MuiBox css-hash"
        >
          <div
            class="MuiBox css-hash"
          >
            <div
              class="MuiBox css-hash"
            >
              <span
                class="MuiTypography MuiTypography css-hash"
              >
                Critical
              </span>
              <p
                class="MuiTypography MuiTypography css-hash"
              >
                Pod status: ImagePullBackOff
              </p>
            </div>
            <p
              class="MuiTypography MuiTypography css-hash"
            >
              Back-off pulling image "doesnotexist:nover" The image could not be pulled. Verify the image name and tag, and that the registry is reachable with valid credentials.
            </p>
            <div
              class="MuiBox css-hash"
            >
              <div
                class="MuiChip MuiChip MuiChip MuiChip MuiChip css-hash"
              >
                <span
                  class="MuiChip MuiChip css-hash"
                >
                  Phase: Pending
                </span>
              </div>
              <div
                class="MuiChip MuiChip MuiChip MuiChip MuiChip css-hash"
              >
                <span
                  class="MuiChip MuiChip css-hash"
                >
                  Ready containers: 0/1
                </span>
              </div>
              <div
                class="MuiChip MuiChip MuiChip MuiChip MuiChip css-hash"
              >
                <span
                  class="MuiChip MuiChip css-hash"
                >
                  Total restarts: 1
                </span>
              </div>
            </div>
          </div>
          <div
            class="MuiBox css-hash"
          >
            <div
              class="MuiBox css-hash"
            >
              <span
                class="MuiTypography MuiTypography css-hash"
              >
                Info
              </span>
              <p
                class="MuiTypography MuiTypography css-hash"
              >
                Previous logs may be available for restarted containers
              </p>
            </div>
            <div
              class="MuiBox css-hash"
            >
              <div
                class="MuiChip MuiChip MuiChip MuiChip MuiChip css-hash"
              >
                <span
                  class="MuiChip MuiChip css-hash"
                >
                  Container: imagepullbackoff (1)
                </span>
              </div>
            </div>
          </div>
          <div
            class="MuiBox css-hash"
          >
            <div
              class="MuiBox css-hash"
            >
              <span
                class="MuiTypography MuiTypography css-hash"
              >
                Warning
              </span>
              <p
                class="MuiTypography MuiTypography css-hash"
              >
                Warning event: Unhealthy (7 times)
              </p>
            </div>
            <p
              class="MuiTypography MuiTypography css-hash"
            >
              Readiness probe failed: HTTP probe failed with statuscode: 500
            </p>
            <div
              class="MuiBox css-hash"
            >
              <div
                class="MuiChip MuiChip MuiChip MuiChip MuiChip css-hash"
              >
                <span
                  class="MuiChip MuiChip css-hash"
                >
                  Last seen: 90d (2023-04-01T10:00:00.000Z)
                </span>
              </div>
              <div
                class="MuiChip MuiChip MuiChip MuiChip MuiChip css-hash"
              >
                <span
                  class="MuiChip MuiChip css-hash"
                >
                  7 times since 90d
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>