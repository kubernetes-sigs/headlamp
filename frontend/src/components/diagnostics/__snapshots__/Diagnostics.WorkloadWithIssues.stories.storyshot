<body>
  <div>
    <div
      class="MuiBox css-hash"
    >
      <div
        class="MuiGrid MuiGrid MuiGrid css-hash"
      >
        <div
          class="MuiGrid MuiGrid css-hash"
        >
          <div
            class="MuiBox css-hash"
          >
            <h2
              class="MuiTypography MuiTypography MuiTypography css-hash"
            >
              Diagnostics
            </h2>
            <div
              class="MuiBox css-hash"
            />
          </div>
        </div>
      </div>
      <div
        class="MuiBox css-hash"
      >
        <div
          class="MuiBox css-hash"
        >
          <div
            class="MuiBox css-hash"
          >
            <div
              class="MuiBox css-hash"
            >
              <span
                class="MuiTypography MuiTypography css-hash"
              >
                Warning
              </span>
              <p
                class="MuiTypography MuiTypography css-hash"
              >
                Deployment has unavailable replicas
              </p>
            </div>
            <div
              class="MuiBox css-hash"
            >
              <div
                class="MuiChip MuiChip MuiChip MuiChip MuiChip css-hash"
              >
                <span
                  class="MuiChip MuiChip css-hash"
                >
                  Desired: 3
                </span>
              </div>
              <div
                class="MuiChip MuiChip MuiChip MuiChip MuiChip css-hash"
              >
                <span
                  class="MuiChip MuiChip css-hash"
                >
                  Available: 1
                </span>
              </div>
              <div
                class="MuiChip MuiChip MuiChip MuiChip MuiChip css-hash"
              >
                <span
                  class="MuiChip MuiChip css-hash"
                >
                  Ready: 1
                </span>
              </div>
              <div
                class="MuiChip MuiChip MuiChip MuiChip MuiChip css-hash"
              >
                <span
                  class="MuiChip MuiChip css-hash"
                >
                  Unavailable: 2
                </span>
              </div>
            </div>
          </div>
          <div
            class="MuiBox css-hash"
          >
            <div
              class="MuiBox css-hash"
            >
              <span
                class="MuiTypography MuiTypography css-hash"
              >
                Critical
              </span>
              <p
                class="MuiTypography MuiTypography css-hash"
              >
                Deployment condition Available is False
              </p>
            </div>
            <p
              class="MuiTypography MuiTypography css-hash"
            >
              Deployment does not have minimum availability.
            </p>
            <div
              class="MuiBox css-hash"
            >
              <div
                class="MuiChip MuiChip MuiChip MuiChip MuiChip css-hash"
              >
                <span
                  class="MuiChip MuiChip css-hash"
                >
                  Reason: MinimumReplicasUnavailable
                </span>
              </div>
            </div>
          </div>
          <div
            class="MuiBox css-hash"
          >
            <div
              class="MuiBox css-hash"
            >
              <span
                class="MuiTypography MuiTypography css-hash"
              >
                Critical
              </span>
              <p
                class="MuiTypography MuiTypography css-hash"
              >
                1 pod is failing with ImagePullBackOff
              </p>
            </div>
            <p
              class="MuiTypography MuiTypography css-hash"
            >
              The image could not be pulled. Verify the image name and tag, and that the registry is reachable with valid credentials.
            </p>
            <div
              class="MuiBox css-hash"
            >
              <div
                class="MuiChip MuiChip MuiChip MuiChip MuiChip css-hash"
              >
                <span
                  class="MuiChip MuiChip css-hash"
                >
                  Unhealthy owned pods: 1/1
                </span>
              </div>
            </div>
            <div
              class="MuiBox css-hash"
            >
              <a
                class="MuiLink MuiLink MuiTypography MuiTypography css-hash"
                href="/c/minikube/pods/default/imagepullbackoff?view=logs&container=imagepullbackoff"
              >
                imagepullbackoff
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>