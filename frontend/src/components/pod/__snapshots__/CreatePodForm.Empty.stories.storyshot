<body>
  <div>
    <div
      class="MuiBox css-hash"
    >
      <div
        aria-label="Resource form"
        class="MuiBox css-hash"
      >
        <fieldset
          class="MuiBox css-hash"
        >
          <legend
            class="MuiTypography MuiTypography css-hash"
          >
            Metadata
          </legend>
          <div
            class="MuiBox css-hash"
          >
            <div
              class="MuiBox css-hash"
            >
              <div
                class="MuiBox css-hash"
              >
                <div
                  class="MuiBox css-hash"
                >
                  <span
                    class="MuiTypography MuiTypography css-hash"
                  >
                    Name
                     *
                  </span>
                </div>
                <div
                  class="MuiFormControl MuiFormControl MuiTextField css-hash"
                >
                  <div
                    class="MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                  >
                    <input
                      aria-invalid="false"
                      aria-label="Name"
                      class="MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                      id=":mock-test-id:"
                      required=""
                      type="text"
                      value=""
                    />
                    <fieldset
                      aria-hidden="true"
                      class="MuiOutlinedInput css-hash"
                    >
                      <legend
                        class="css-hash"
                      >
                        <span
                          class="notranslate"
                        >
                          ​
                        </span>
                      </legend>
                    </fieldset>
                  </div>
                </div>
              </div>
            </div>
            <div
              class="MuiBox css-hash"
            >
              <div
                class="MuiBox css-hash"
              >
                <div
                  class="MuiBox css-hash"
                >
                  <span
                    class="MuiTypography MuiTypography css-hash"
                  >
                    Namespace
                  </span>
                </div>
                <div
                  class="MuiAutocomplete MuiAutocomplete css-hash"
                >
                  <div
                    class="MuiFormControl MuiFormControl MuiTextField css-hash"
                  >
                    <div
                      class="MuiAutocomplete MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                    >
                      <input
                        aria-autocomplete="list"
                        aria-expanded="false"
                        aria-invalid="false"
                        autocapitalize="none"
                        autocomplete="off"
                        class="MuiAutocomplete MuiAutocomplete MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                        id=":mock-test-id:"
                        role="combobox"
                        spellcheck="false"
                        type="text"
                        value=""
                      />
                      <div
                        class="MuiAutocomplete css-hash"
                      >
                        <button
                          aria-label="Clear"
                          class="MuiAutocomplete MuiButtonBase MuiIconButton MuiIconButton css-hash"
                          tabindex="-1"
                          title="Clear"
                          type="button"
                        >
                          <svg
                            aria-hidden="true"
                            class="MuiSvgIcon-root MuiSvgIcon-fontSizeSmall css-ptiqhd-MuiSvgIcon-root"
                            data-testid="CloseIcon"
                            focusable="false"
                            viewBox="0 0 24 24"
                          >
                            <path
                              d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                            />
                          </svg>
                          <span
                            class="MuiTouchRipple css-hash"
                          />
                        </button>
                      </div>
                      <fieldset
                        aria-hidden="true"
                        class="MuiOutlinedInput css-hash"
                      >
                        <legend
                          class="css-hash"
                        >
                          <span
                            class="notranslate"
                          >
                            ​
                          </span>
                        </legend>
                      </fieldset>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div
              class="MuiBox css-hash"
            >
              <div
                class="MuiBox css-hash"
              >
                <div
                  class="MuiBox css-hash"
                >
                  <span
                    class="MuiTypography MuiTypography css-hash"
                  >
                    Labels
                  </span>
                </div>
                <div
                  aria-labelledby="label-group-id"
                  class="MuiBox css-hash"
                  role="group"
                >
                  <div
                    class="MuiBox css-hash"
                  >
                    <button
                      aria-label="Add label"
                      class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
                      tabindex="0"
                      type="button"
                    >
                      <p
                        class="MuiTypography MuiTypography css-hash"
                      >
                        New Label
                      </p>
                      <span
                        class="MuiTouchRipple css-hash"
                      />
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </fieldset>
        <fieldset
          class="MuiBox css-hash"
        >
          <legend
            class="MuiTypography MuiTypography css-hash"
          >
            Spec
          </legend>
          <div
            class="MuiBox css-hash"
          >
            <div
              class="MuiBox css-hash"
            >
              <div
                class="MuiBox css-hash"
              >
                <div
                  class="MuiBox css-hash"
                >
                  <span
                    class="MuiTypography MuiTypography css-hash"
                  >
                    Containers
                     *
                  </span>
                </div>
                <div
                  aria-labelledby="container-group-id"
                  class="MuiBox css-hash"
                  role="group"
                >
                  <div
                    class="MuiBox css-hash"
                  >
                    <button
                      aria-label="Add container"
                      class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
                      tabindex="0"
                      type="button"
                    >
                      <p
                        class="MuiTypography MuiTypography css-hash"
                      >
                        New Container
                      </p>
                      <span
                        class="MuiTouchRipple css-hash"
                      />
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </fieldset>
        <fieldset
          class="MuiBox css-hash"
        >
          <legend
            class="MuiTypography MuiTypography css-hash"
          >
            Node
          </legend>
          <div
            class="MuiBox css-hash"
          >
            <div
              class="MuiBox css-hash"
            >
              <div
                class="MuiBox css-hash"
              >
                <div
                  class="MuiBox css-hash"
                >
                  <span
                    class="MuiTypography MuiTypography css-hash"
                  >
                    Node Name
                  </span>
                  <button
                    aria-label="Optional: schedule the pod on a specific node"
                    class="MuiButtonBase MuiIconButton MuiIconButton css-hash"
                    data-mui-internal-clone-element="true"
                    tabindex="0"
                    type="button"
                  >
                    <span
                      class="MuiTouchRipple css-hash"
                    />
                  </button>
                </div>
                <div
                  class="MuiFormControl MuiFormControl MuiTextField css-hash"
                >
                  <div
                    class="MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                  >
                    <input
                      aria-invalid="false"
                      aria-label="Node Name"
                      class="MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
                      id=":mock-test-id:"
                      type="text"
                      value=""
                    />
                    <fieldset
                      aria-hidden="true"
                      class="MuiOutlinedInput css-hash"
                    >
                      <legend
                        class="css-hash"
                      >
                        <span
                          class="notranslate"
                        >
                          ​
                        </span>
                      </legend>
                    </fieldset>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </fieldset>
      </div>
    </div>
  </div>
</body>