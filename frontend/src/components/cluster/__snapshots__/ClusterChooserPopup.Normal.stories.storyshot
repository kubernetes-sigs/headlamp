<body>
  <div
    aria-hidden="true"
  >
    <span />
  </div>
  <div
    aria-busy="false"
    aria-labelledby="chooser-dialog-title"
    class="MuiModal MuiPopover css-hash"
    role="presentation"
  >
    <div
      aria-hidden="true"
      class="MuiBackdrop MuiBackdrop MuiModal css-hash"
      style="opacity: 1; transition: opacity 225ms cubic-bezier(0.4, 0, 0.2, 1) 0ms;"
    />
    <div
      data-testid="sentinelStart"
      tabindex="0"
    />
    <div
      class="MuiPaper MuiPaper MuiPaper MuiPopover css-hash"
      style="opacity: 1; transform: none; transition: opacity 0ms cubic-bezier(0.4, 0, 0.2, 1) 0ms,transform 0ms cubic-bezier(0.4, 0, 0.2, 1) 0ms; top: 16px; left: 16px; transform-origin: -16px -16px;"
      tabindex="-1"
    >
      <div
        class="MuiBox css-hash"
      >
        <div
          class="MuiFormControl MuiFormControl MuiTextField css-hash"
        >
          <label
            class="Mui-focused MuiFormLabel MuiFormLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel MuiInputLabel css-hash"
            data-shrink="true"
            for="filled-size-small"
            id="filled-size-small-label"
          >
            Choose cluster
          </label>
          <div
            aria-haspopup="listbox"
            aria-owns="cluster-chooser-list"
            class="Mui-focused MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
          >
            <input
              aria-invalid="false"
              class="MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
              id="filled-size-small"
              placeholder="Name"
              type="text"
              value=""
            />
            <fieldset
              aria-hidden="true"
              class="MuiOutlinedInput css-hash"
            >
              <legend
                class="css-hash"
              >
                <span>
                  Choose cluster
                </span>
              </legend>
            </fieldset>
          </div>
        </div>
        <ul
          class="MuiList MuiList MuiList css-hash"
          id="cluster-chooser-list"
          role="listbox"
          tabindex="0"
        >
          <li
            class="MuiListSubheader MuiListSubheader css-hash"
            role="presentation"
          >
            Recent clusters
          </li>
          <li
            aria-selected="true"
            class="MuiButtonBase MuiMenuItem MuiMenuItem MuiMenuItem MuiMenuItem css-hash"
            id="cluster2"
            role="option"
            tabindex="-1"
          >
            <div
              class="MuiBox css-hash"
            >
              <span
                class="MuiTypography MuiTypography css-hash"
              >
                cluster2
              </span>
            </div>
            <div
              class="MuiListItemText MuiListItemText css-hash"
            >
              <p
                class="MuiListItemText MuiTypography MuiTypography css-hash"
              >
                Current
              </p>
            </div>
            <span
              class="MuiTouchRipple css-hash"
            />
          </li>
          <li
            aria-selected="false"
            class="MuiButtonBase MuiMenuItem MuiMenuItem MuiMenuItem MuiMenuItem css-hash"
            id="cluster1"
            role="option"
            tabindex="-1"
          >
            <div
              class="MuiBox css-hash"
            >
              <span
                class="MuiTypography MuiTypography css-hash"
              >
                cluster1
              </span>
            </div>
            <span
              class="MuiTouchRipple css-hash"
            />
          </li>
          <li
            aria-selected="false"
            class="MuiButtonBase MuiMenuItem MuiMenuItem MuiMenuItem MuiMenuItem css-hash"
            id="cluster3"
            role="option"
            tabindex="-1"
          >
            <div
              class="MuiBox css-hash"
            >
              <span
                class="MuiTypography MuiTypography css-hash"
              >
                cluster3
              </span>
            </div>
            <span
              class="MuiTouchRipple css-hash"
            />
          </li>
          <hr
            class="MuiDivider MuiDivider css-hash"
            role="separator"
          />
          <li
            aria-selected="false"
            class="MuiButtonBase MuiMenuItem MuiMenuItem MuiMenuItem MuiMenuItem css-hash"
            id="cluster0"
            role="option"
            tabindex="-1"
          >
            <div
              class="MuiBox css-hash"
            >
              <span
                class="MuiTypography MuiTypography css-hash"
              >
                cluster0
              </span>
            </div>
            <span
              class="MuiTouchRipple css-hash"
            />
          </li>
          <li
            aria-selected="false"
            class="MuiButtonBase MuiMenuItem MuiMenuItem MuiMenuItem MuiMenuItem css-hash"
            id="cluster4"
            role="option"
            tabindex="-1"
          >
            <div
              class="MuiBox css-hash"
            >
              <span
                class="MuiTypography MuiTypography css-hash"
              >
                cluster4
              </span>
            </div>
            <span
              class="MuiTouchRipple css-hash"
            />
          </li>
        </ul>
      </div>
    </div>
    <div
      data-testid="sentinelEnd"
      tabindex="0"
    />
  </div>
</body>