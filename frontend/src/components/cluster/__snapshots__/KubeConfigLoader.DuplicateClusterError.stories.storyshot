<body>
  <div
    aria-hidden="true"
  />
  <div
    class="MuiDialog MuiModal css-hash"
    role="presentation"
  >
    <div
      aria-hidden="true"
      class="MuiBackdrop MuiModal css-hash"
      style="opacity: 1; transition: opacity 225ms cubic-bezier(0.4, 0, 0.2, 1) 0ms;"
    />
    <div
      data-testid="sentinelStart"
      tabindex="0"
    />
    <div
      class="MuiDialog MuiDialog css-hash"
      role="presentation"
      style="opacity: 1; transition: opacity 225ms cubic-bezier(0.4, 0, 0.2, 1) 0ms;"
      tabindex="-1"
    >
      <div
        aria-labelledby=":mock-test-id:"
        class="MuiDialog MuiDialog MuiDialog MuiPaper MuiPaper MuiPaper css-hash"
        role="dialog"
      >
        <h2
          class="MuiDialogTitle MuiTypography MuiTypography css-hash"
          id=":mock-test-id:"
          style="display: flex;"
        >
          <div
            class="MuiGrid MuiGrid css-hash"
          >
            <div
              class="MuiGrid MuiGrid css-hash"
            >
              <div>
                <div
                  class="MuiBox css-hash"
                />
                <span
                  class="MuiBox css-hash"
                >
                  Headlamp
                </span>
              </div>
            </div>
            <div
              class="MuiGrid MuiGrid css-hash"
            >
              <div
                class="MuiBox css-hash"
              />
            </div>
          </div>
        </h2>
        <div
          class="MuiDialogContent MuiDialogContent css-hash"
        >
          <h2
            class="MuiDialogTitle MuiTypography MuiTypography css-hash"
            id=":mock-test-id:"
            style="display: flex;"
          >
            <div
              class="MuiGrid MuiGrid css-hash"
            >
              <div
                class="MuiGrid MuiGrid css-hash"
              >
                <h1
                  class="MuiTypography MuiTypography css-hash"
                  style="font-size: 1.25rem; font-weight: 500; line-height: 1.6;"
                >
                  Load from KubeConfig
                </h1>
              </div>
            </div>
          </h2>
          <div
            class="MuiBox css-hash"
            style="background-color: rgb(244, 67, 54); color: white; text-align: center; padding: 12px; margin-bottom: 16px; border-radius: 4px;"
          >
            Duplicate cluster: production in the list. Please edit the context name.
          </div>
          <div
            class="MuiBox css-hash"
          >
            <div
              class="MuiBox css-hash"
              style="display: flex; flex-direction: column; justify-content: center; text-align: center; align-items: center;"
            >
              <p
                class="MuiTypography MuiTypography css-hash"
              >
                Select clusters
              </p>
              <div
                class="MuiBox css-hash"
              >
                <div
                  class="MuiFormControl css-hash"
                >
                  <label
                    class="MuiFormControlLabel MuiFormControlLabel css-hash"
                  >
                    <span
                      class="Mui-checked MuiButtonBase MuiCheckbox MuiCheckbox MuiCheckbox MuiCheckbox MuiCheckbox MuiCheckbox MuiCheckbox MuiCheckbox MuiCheckbox PrivateSwitchBase-root css-hash"
                    >
                      <input
                        checked=""
                        class="PrivateSwitchBase-input css-hash"
                        data-indeterminate="false"
                        name="production"
                        type="checkbox"
                        value="production"
                      />
                      <svg
                        aria-hidden="true"
                        class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium css-i4bv87-MuiSvgIcon-root"
                        data-testid="CheckBoxIcon"
                        focusable="false"
                        viewBox="0 0 24 24"
                      >
                        <path
                          d="M19 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.11 0 2-.9 2-2V5c0-1.1-.89-2-2-2zm-9 14l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"
                        />
                      </svg>
                      <span
                        class="MuiTouchRipple css-hash"
                      />
                    </span>
                    <span
                      class="MuiFormControlLabel MuiTypography MuiTypography css-hash"
                    >
                      production
                    </span>
                  </label>
                  <label
                    class="MuiFormControlLabel MuiFormControlLabel css-hash"
                  >
                    <span
                      class="Mui-checked MuiButtonBase MuiCheckbox MuiCheckbox MuiCheckbox MuiCheckbox MuiCheckbox MuiCheckbox MuiCheckbox MuiCheckbox MuiCheckbox PrivateSwitchBase-root css-hash"
                    >
                      <input
                        checked=""
                        class="PrivateSwitchBase-input css-hash"
                        data-indeterminate="false"
                        name="staging"
                        type="checkbox"
                        value="staging"
                      />
                      <svg
                        aria-hidden="true"
                        class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium css-i4bv87-MuiSvgIcon-root"
                        data-testid="CheckBoxIcon"
                        focusable="false"
                        viewBox="0 0 24 24"
                      >
                        <path
                          d="M19 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.11 0 2-.9 2-2V5c0-1.1-.89-2-2-2zm-9 14l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"
                        />
                      </svg>
                      <span
                        class="MuiTouchRipple css-hash"
                      />
                    </span>
                    <span
                      class="MuiFormControlLabel MuiTypography MuiTypography css-hash"
                    >
                      staging
                    </span>
                  </label>
                  <label
                    class="MuiFormControlLabel MuiFormControlLabel css-hash"
                  >
                    <span
                      class="MuiButtonBase MuiCheckbox MuiCheckbox MuiCheckbox MuiCheckbox MuiCheckbox MuiCheckbox MuiCheckbox MuiCheckbox MuiCheckbox PrivateSwitchBase-root css-hash"
                    >
                      <input
                        class="PrivateSwitchBase-input css-hash"
                        data-indeterminate="false"
                        name="development"
                        type="checkbox"
                        value="development"
                      />
                      <svg
                        aria-hidden="true"
                        class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium css-i4bv87-MuiSvgIcon-root"
                        data-testid="CheckBoxOutlineBlankIcon"
                        focusable="false"
                        viewBox="0 0 24 24"
                      >
                        <path
                          d="M19 5v14H5V5h14m0-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"
                        />
                      </svg>
                      <span
                        class="MuiTouchRipple css-hash"
                      />
                    </span>
                    <span
                      class="MuiFormControlLabel MuiTypography MuiTypography css-hash"
                    >
                      development
                    </span>
                  </label>
                </div>
                <div
                  class="MuiGrid MuiGrid MuiGrid MuiGrid css-hash"
                >
                  <div
                    class="MuiGrid MuiGrid css-hash"
                  >
                    <button
                      class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
                      tabindex="0"
                      type="button"
                    >
                      Next
                      <span
                        class="MuiTouchRipple css-hash"
                      />
                    </button>
                  </div>
                  <div
                    class="MuiGrid MuiGrid css-hash"
                  >
                    <button
                      class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
                      tabindex="0"
                      type="button"
                    >
                      Back
                      <span
                        class="MuiTouchRipple css-hash"
                      />
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div
      data-testid="sentinelEnd"
      tabindex="0"
    />
  </div>
</body>