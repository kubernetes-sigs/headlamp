<body>
  <div
    aria-hidden="true"
  />
  <div
    class="MuiDialog MuiModal css-hash"
    role="presentation"
  >
    <div
      aria-hidden="true"
      class="MuiBackdrop MuiModal css-hash"
      style="opacity: 1; transition: opacity 225ms cubic-bezier(0.4, 0, 0.2, 1) 0ms;"
    />
    <div
      data-testid="sentinelStart"
      tabindex="0"
    />
    <div
      class="MuiDialog MuiDialog css-hash"
      role="presentation"
      style="opacity: 1; transition: opacity 225ms cubic-bezier(0.4, 0, 0.2, 1) 0ms;"
      tabindex="-1"
    >
      <div
        aria-labelledby=":mock-test-id:"
        class="MuiDialog MuiDialog MuiDialog MuiPaper MuiPaper MuiPaper css-hash"
        role="dialog"
      >
        <h2
          class="MuiDialogTitle MuiTypography MuiTypography css-hash"
          id=":mock-test-id:"
          style="display: flex;"
        >
          <div
            class="MuiGrid MuiGrid css-hash"
          >
            <div
              class="MuiGrid MuiGrid css-hash"
            >
              <div>
                <div
                  class="MuiBox css-hash"
                />
                <span
                  class="MuiBox css-hash"
                >
                  Headlamp
                </span>
              </div>
            </div>
            <div
              class="MuiGrid MuiGrid css-hash"
            >
              <div
                class="MuiBox css-hash"
              />
            </div>
          </div>
        </h2>
        <div
          class="MuiDialogContent MuiDialogContent css-hash"
        >
          <h2
            class="MuiDialogTitle MuiTypography MuiTypography css-hash"
            id=":mock-test-id:"
            style="display: flex;"
          >
            <div
              class="MuiGrid MuiGrid css-hash"
            >
              <div
                class="MuiGrid MuiGrid css-hash"
              >
                <h1
                  class="MuiTypography MuiTypography css-hash"
                  style="font-size: 1.25rem; font-weight: 500; line-height: 1.6;"
                >
                  Load from KubeConfig
                </h1>
              </div>
            </div>
          </h2>
          <div
            class="MuiBox css-hash"
            style="background-color: rgb(244, 67, 54); color: white; text-align: center; padding: 12px; margin-bottom: 16px; border-radius: 4px;"
          >
            Invalid kubeconfig file: unexpected end of file at line 45
          </div>
          <div
            class="MuiBox css-hash"
          >
            <div
              class="MuiBox css-hash"
            >
              <div
                class="MuiBox css-hash"
                role="presentation"
                tabindex="0"
              >
                <div
                  class="MuiFormControl css-hash"
                >
                  <input
                    style="border: 0px; clip: rect(0px, 0px, 0px, 0px); clip-path: inset(50%); height: 1px; margin: 0px -1px -1px 0px; overflow: hidden; padding: 0px; position: absolute; width: 1px; white-space: nowrap;"
                    tabindex="-1"
                    type="file"
                  />
                  <button
                    aria-label="Drag & drop or choose kubeconfig file here"
                    class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
                    data-mui-internal-clone-element="true"
                    tabindex="0"
                    type="button"
                  >
                    <span
                      class="MuiButton MuiButton MuiButton css-hash"
                    />
                    Choose file
                    <span
                      class="MuiTouchRipple css-hash"
                    />
                  </button>
                </div>
              </div>
              <div
                class="MuiBox css-hash"
                style="display: flex; justify-content: center;"
              >
                <button
                  class="MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButton MuiButtonBase css-hash"
                  tabindex="0"
                  type="button"
                >
                  Back
                  <span
                    class="MuiTouchRipple css-hash"
                  />
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div
      data-testid="sentinelEnd"
      tabindex="0"
    />
  </div>
</body>