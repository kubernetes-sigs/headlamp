<body>
  <div>
    <div
      class="MuiBox css-hash"
    >
      <div
        class="MuiFormControl MuiFormControl MuiTextField css-hash"
      >
        <div
          aria-activedescendant=""
          aria-autocomplete="list"
          aria-expanded="false"
          autocapitalize="none"
          class="Mui-focused MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
          role="combobox"
          spellcheck="false"
        >
          <input
            aria-invalid="false"
            autocomplete="off"
            class="MuiInputBase MuiInputBase MuiInputBase MuiOutlinedInput css-hash"
            id=":mock-test-id:"
            placeholder="Search resources, pages, clusters by name"
            type="text"
            value=""
          />
          <button
            aria-label="Clear"
            class="MuiButtonBase MuiIconButton MuiIconButton css-hash"
            data-mui-internal-clone-element="true"
            tabindex="0"
            type="button"
          >
            <span
              class="MuiTouchRipple css-hash"
            />
          </button>
          <fieldset
            aria-hidden="true"
            class="MuiOutlinedInput css-hash"
          >
            <legend
              class="css-hash"
            >
              <span
                class="notranslate"
              >
                ​
              </span>
            </legend>
          </fieldset>
        </div>
      </div>
    </div>
  </div>
  <div
    class="MuiPopper css-hash"
    data-popper-escaped=""
    data-popper-placement="bottom"
    data-popper-reference-hidden=""
    role="tooltip"
    style="position: absolute; top: 0px; left: 0px; margin: 0px; right: auto; bottom: auto; transform: translate(0px, 0px);"
  >
    <ul
      aria-labelledby=":mock-test-id:"
      class="MuiPaper MuiPaper MuiPaper css-hash"
      id=":mock-test-id:"
      role="listbox"
    />
  </div>
</body>