  "commandSets": {
    "minikube": [
      { "tool": "minikube", "args": ["start"], "allowTrailingArgs": true },
      { "tool": "minikube", "args": ["stop"], "allowTrailingArgs": true },
      { "tool": "minikube", "args": ["delete"], "allowTrailingArgs": true },
      { "tool": "minikube", "args": ["status"], "allowTrailingArgs": true },
